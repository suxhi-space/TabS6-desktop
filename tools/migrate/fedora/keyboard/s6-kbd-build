"""Build S6 Keyboard: a copy of Maliit's own QML (Fedora's maliit-keyboard) with S6's Gboard-style additions:
the top bar (emoji, clipboard, undo, redo, hide), a strip under the keys with hide and clipboard, and clipboard
history. Maliit loads it when started with KEYBOARD_PREFIX_PATH (s6-keyboard does that); Fedora's files are never
changed. Every change point is checked first: if Fedora's Maliit has changed shape, nothing is built and the stock
keyboard runs.

    s6-kbd-build STOCK_QML_DIR PREFIX CLIPS_FILE STAMP
"""
import os, shutil, sys

stock, prefix, clips, stamp = sys.argv[1:5]
ours = os.environ.get("S6KB_SRC", "/usr/local/share/s6migrate/keyboard")
new = prefix + ".new"
shutil.rmtree(new, ignore_errors=True)
dest = new + os.path.abspath(stock)                # Maliit reads PREFIX + its absolute QML path
shutil.copytree(stock, dest, symlinks=True)
# Maliit adds the same PREFIX to its language plugins (the key layouts, next to qml/) and to the spell-check
# dictionaries: link those back to the real ones, or the keyboard comes up with no keys at all (it did).
parent = os.path.dirname(os.path.abspath(stock))
for name in os.listdir(parent):
    if name != os.path.basename(stock):
        os.symlink(os.path.join(parent, name), os.path.join(new + parent, name))
for d in ("/usr/share/hunspell", "/usr/share/myspell"):
    if os.path.isdir(d):
        os.makedirs(os.path.dirname(new + d), exist_ok=True)
        os.symlink(d, new + d)


def patch(name, pairs):
    p = os.path.join(dest, name)
    s = open(p, encoding="utf-8").read()
    for a, b in pairs:
        n = s.count(a)
        if n != 1:
            sys.exit("%s: change point found %d times: %r" % (name, n, a[:60]))
        s = s.replace(a, b)
    open(p, "w", encoding="utf-8").write(s)


patch("Keyboard.qml", [
    ("    property variant event_handler: MaliitEventHandler\n",
     "    property variant event_handler: MaliitEventHandler\n"
     "    property bool s6clips: false                       // S6: clipboard history shown instead of the keys\n"
     "    readonly property real s6nav: Device.gu(5)         // S6: the strip under the keys\n"),
    (": Device.keyboardHeightPortrait)\n",
     ": Device.keyboardHeightPortrait) * fullScreenItem.s6scale + fullScreenItem.s6nav\n"),
    ("                    height: parent.height\n                    width: parent.width\n                    anchors.bottom: parent.bottom\n",
     "                    height: parent.height - fullScreenItem.s6nav\n                    width: parent.width\n"
     "                    anchors.bottom: parent.bottom\n                    anchors.bottomMargin: fullScreenItem.s6nav\n"),
    ("                    LanguageMenu {\n                        id: languageMenu\n",
     "                    S6Clips { anchors.fill: parent; visible: fullScreenItem.s6clips; z: 5 }\n\n"
     "                    LanguageMenu {\n                        id: languageMenu\n"),
    ("                } // keyboardComp\n",
     "                } // keyboardComp\n\n"
     "                S6Nav { anchors.bottom: parent.bottom; width: parent.width; height: fullScreenItem.s6nav }\n"),
])
# Gboard-style colours: the keys are drawn by KDE's button style (Breeze) unless given their own background.
# Dark or light follows your colour scheme; Enter takes your accent colour (the one carried over from Android).
patch("Keyboard.qml", [
    ("    property bool landscape: width > height\n",
     "    property bool landscape: width > height\n"
     "    S6Style { id: s6style }   // S6: colours and options (S6 Companion > Look > Keyboard)\n"
     "    readonly property bool s6dark: s6style.dark\n"
     "    readonly property color s6bg: s6style.bg\n"
     "    readonly property color s6key: s6style.key\n"
     "    readonly property color s6fn: s6style.fn\n"
     "    readonly property color s6down: s6style.down\n"
     "    readonly property color s6text: s6style.text\n"
     "    readonly property color s6accent: s6style.accent\n"
     "    readonly property color s6accentText: s6style.accentText\n"
     "    readonly property bool s6borders: s6style.borders\n"
     "    readonly property bool s6hints: s6style.hints\n"
     "    readonly property real s6scale: s6style.scale\n"),
    ("                height: canvas.height\n",
     "                height: canvas.height\n"
     "                background: Rectangle { color: fullScreenItem.s6bg }   // S6\n"),
    ("                    color: \"#888888\"\n                    anchors.bottom: wordRibbon.visible",
     "                    color: \"transparent\"   // S6: no line above the keys\n                    anchors.bottom: wordRibbon.visible"),
])
patch("keys/CharKey.qml", [
    ("            hoverEnabled: false\n",
     "            hoverEnabled: false\n"
     "            // S6: Gboard-style key: rounded, letter keys light, the others darker, Enter in your accent colour\n"
     "            readonly property bool s6fnKey: key.noMagnifier && key.action !== \"space\"\n"
     "            readonly property bool s6enter: key.action === \"return\"\n"
     "            icon.color: s6enter ? fullScreenItem.s6accentText : fullScreenItem.s6text\n"
     "            background: Rectangle {\n"
     "                radius: Math.min(width, height) * 0.2\n"
     "                color: keyButton.down ? (keyButton.s6enter ? Qt.darker(fullScreenItem.s6accent, 1.25) : fullScreenItem.s6down)\n"
     "                     : keyButton.s6enter ? fullScreenItem.s6accent : !fullScreenItem.s6borders ? \"transparent\"\n"
     "                     : keyButton.s6fnKey ? fullScreenItem.s6fn : fullScreenItem.s6key\n"
     "                Behavior on color { ColorAnimation { duration: 90 } }\n"
     "            }\n"),
    ("                font.pixelSize: key.fontSize / 2\n                font.weight: Font.Light\n                visible: !panel.hideKeyLabels\n",
     "                font.pixelSize: key.fontSize / 2\n                font.weight: Font.Light\n"
     "                color: fullScreenItem.s6text; opacity: 0.6\n"
     "                visible: !panel.hideKeyLabels && fullScreenItem.s6hints   // S6: number hints on or off\n"),
    ("                font.weight: Font.Light\n                anchors.right: parent.right\n",
     "                font.weight: Font.Normal\n"
     "                color: keyButton.s6enter ? fullScreenItem.s6accentText : fullScreenItem.s6text\n"
     "                anchors.right: parent.right\n"),
])
# The key next to "?123" is always the emoji key (it became a language key whenever Fedora enabled more languages)
patch("keys/LanguageKey.qml", [
    ("    readonly property bool altLangs: Keyboard.enabledLanguages.length > 1\n",
     "    readonly property bool altLangs: false   // S6: always the emoji key\n"),
])
patch("WordRibbon.qml", [
    ("        spacing: Device.gu(2)\n    }\n",
     "        spacing: Device.gu(2)\n    }\n\n"
     "    // S6: Gboard's top bar while there is nothing to suggest\n"
     "    S6Toolbar { anchors.fill: parent; visible: listView.count === 0 }\n"),
])
style = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "s6migrate", "keyboard.json")
for f in ("S6Toolbar.qml", "S6Nav.qml", "S6Clips.qml", "S6Style.qml"):
    s = open(os.path.join(ours, f), encoding="utf-8").read().replace("@CLIPS@", clips).replace("@KBSTYLE@", style)
    open(os.path.join(dest, f), "w", encoding="utf-8").write(s)
open(os.path.join(new, "ok"), "w").write(stamp)
shutil.rmtree(prefix, ignore_errors=True)
os.rename(new, prefix)
print("S6 Keyboard built from", stock)
