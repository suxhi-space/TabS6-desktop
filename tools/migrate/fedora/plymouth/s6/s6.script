# S6 Migrate start-up screen: the Fedora logo (Fedora's own file, linked in by s6-helper) and a thin progress bar,
# like a Mac starting. Messages (e.g. a disk check) appear quietly underneath.
Window.SetBackgroundTopColor(0.035, 0.043, 0.06);
Window.SetBackgroundBottomColor(0.035, 0.043, 0.06);
W = Window.GetWidth();
H = Window.GetHeight();

logo.image = Image("logo.png");
lw = logo.image.GetWidth();
lh = logo.image.GetHeight();
maxw = W * 0.2;
if (lw > maxw) {
  logo.image = logo.image.Scale(maxw, lh * maxw / lw);
}
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(W / 2 - logo.image.GetWidth() / 2, H * 0.44 - logo.image.GetHeight() / 2, 1);

bw = W * 0.15;
if (bw < 160) bw = 160;
bh = Math.Int(H / 280);
if (bh < 4) bh = 4;
by = H * 0.44 + logo.image.GetHeight() / 2 + H * 0.09;
track.image = Image("track.png").Scale(bw, bh);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(W / 2 - bw / 2, by, 1);
fill.base = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(W / 2 - bw / 2, by, 2);

fun progress_cb(duration, progress) {
  w = Math.Int(bw * progress);
  if (w < bh) w = bh;
  fill.sprite.SetImage(fill.base.Scale(w, bh));
}
Plymouth.SetBootProgressFunction(progress_cb);

fun message_cb(text) {
  msg.image = Image.Text(text, 0.75, 0.8, 0.87);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(W / 2 - msg.image.GetWidth() / 2, H * 0.86, 3);
}
Plymouth.SetMessageFunction(message_cb);
