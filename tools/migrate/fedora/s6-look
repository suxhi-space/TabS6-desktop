#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# s6-look - desktop layout, size and look, in your own Plasma session (no root).
#
#   s6-look layout touch|centered|traditional|topdock|plasma
#   s6-look size standard|larger|largest     screen scale from the tablet's original (+0, +25%, +50%) and touch mode
#   s6-look theme light|dark
#   s6-look effects off|soft|glassy          blur, translucency and window animations (KWin's own effects)
#   s6-look dolphin touch|centered|traditional|topdock|plasma   the file manager to match a layout
#   s6-look install-themes                   the layouts as Plasma Global Themes ("S6 Touch"...), also in System Settings
#   s6-look heal                             at login: if Better Blur DX or Darkly stopped working after an update,
#                                            fall back to Plasma's own blur / Breeze until they work again
#
# When installed (s6-helper look-extras), Better Blur DX (xarblu) replaces Plasma's blur and Darkly (Bali10050)
# replaces the Breeze app style, for frosted, rounded windows. Without them, Plasma's own effects are used.
#   s6-look status                           LAYOUT|.. SIZE|.. THEME|..
#   s6-look show-panels                      bring back panels set to auto-hide (on a touch screen they can't be
#                                            brought back by pointing at the edge)
#
# Layouts (named by what they look like):
#   touch        one tall floating bottom bar with big icons: made for fingers (default)
#   centered     a bottom taskbar with the app icons in the middle
#   traditional  a full-width bottom taskbar with the menu on the left and window names
#   topdock      a slim bar at the top with the menu and clock, and a dock at the bottom
#   plasma       KDE Plasma's own default
set -u
SELF=$(readlink -f "$0")
CONF="$HOME/.config/s6migrate/look.conf"
mkdir -p "${CONF%/*}"
q() { command -v qdbus6 >/dev/null && echo qdbus6 || echo qdbus; }
setconf() { touch "$CONF"; grep -v "^$1=" "$CONF" > "$CONF.tmp"; echo "$1=$2" >> "$CONF.tmp"; mv "$CONF.tmp" "$CONF"; }
getconf() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n 1; }
plasma_js() { "$(q)" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1"; }
kw() { kwriteconfig6 "$@"; }
PLUG=${S6L_PLUGINS:-/usr/lib64/qt6/plugins /usr/lib/qt6/plugins}   # test hook
has_bbdx() { find $PLUG -name 'better_blur_dx*.so' 2>/dev/null | grep -q .; }
has_darkly() { find $PLUG -path '*styles*' -iname '*darkly*' 2>/dev/null | grep -q .; }
bbdx_loaded() { [ "$("$(q)" org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded better_blur_dx 2>/dev/null)" = true ]; }
use_blur() { # use_blur stock|bbdx|none
  case "$1" in
    bbdx)  kw --file kwinrc --group Plugins --key blurEnabled false; kw --file kwinrc --group Plugins --key better_blur_dxEnabled true ;;
    stock) kw --file kwinrc --group Plugins --key better_blur_dxEnabled false; kw --file kwinrc --group Plugins --key blurEnabled true ;;
    none)  kw --file kwinrc --group Plugins --key better_blur_dxEnabled false; kw --file kwinrc --group Plugins --key blurEnabled false ;;
  esac
}
bbdx() { kw --file kwinrc --group Effect-better-blur-dx "$@"; }
darkly() { kw --file darklyrc "$@"; }
use_style() { # use_style darkly|breeze: app style and window borders
  if [ "$1" = darkly ] && has_darkly; then
    kw --file kdeglobals --group KDE --key widgetStyle Darkly
    kw --file kwinrc --group org.kde.kdecoration2 --key library org.kde.darkly
    kw --file kwinrc --group org.kde.kdecoration2 --key theme Darkly
  else
    kw --file kdeglobals --group KDE --key widgetStyle Breeze
    kw --file kwinrc --group org.kde.kdecoration2 --key library org.kde.breeze
    kw --file kwinrc --group org.kde.kdecoration2 --key theme Breeze
  fi
}
# Window borders per layout: buttons (M menu, I minimise, A maximise, X close), button size, title, roundness.
layout_borders() { # layout_borders NAME -> "left|right|size|title|radius"
  case "$1" in
    touch)       echo "|IAX|ButtonLarge|AlignCenter|12" ;;
    centered)    echo "|IAX|ButtonDefault|AlignLeft|10" ;;
    traditional) echo "M|IAX|ButtonDefault|AlignLeft|4" ;;
    topdock)     echo "XIA||ButtonDefault|AlignCenter|12" ;;
    *)           echo "MS|HIAX|ButtonDefault|AlignLeft|6" ;;
  esac
}
apply_borders() {
  IFS='|' read -r bl br bs ta cr <<< "$(layout_borders "$1")"
  kw --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft "$bl"
  kw --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight "$br"
  for f in darklyrc breezerc; do
    kw --file "$f" --group Windeco --key ButtonSize "$bs"
    kw --file "$f" --group Windeco --key TitleAlignment "$ta"
  done
  kw --file darklyrc --group Common --key CornerRadius "$cr"
}
kwin_reload() { "$(q)" org.kde.KWin /KWin reconfigure >/dev/null 2>&1; }
panel_opacity() { # 0 adaptive, 1 opaque, 2 translucent: for every panel (Plasma keeps it in plasmashellrc)
  local ids id
  ids=$(plasma_js 'print(panelIds.join(" "))' 2>/dev/null)
  for id in $ids; do kw --file plasmashellrc --group PlasmaViews --group "Panel $id" --key panelOpacity "$1"; done
  [ -n "$ids" ] && { systemctl --user restart plasma-plasmashell.service 2>/dev/null || (plasmashell --replace >/dev/null 2>&1 &); }
}
dolphin_style() { # view mode 0 icons, 1 details; icon sizes; single tap to open
  local mode=$1 icons=$2 single=$3 previews=$4 vp="$HOME/.local/share/dolphin/view_properties/global"
  mkdir -p "$vp"
  printf '[Dolphin]\nVersion=4\nViewMode=%s\nPreviewsShown=%s\n' "$mode" "$previews" > "$vp/.directory"
  kw --file dolphinrc --group General --key GlobalViewProps true
  kw --file dolphinrc --group IconsMode --key IconSize "$icons"
  kw --file dolphinrc --group DetailsMode --key IconSize "$([ "$icons" -ge 80 ] && echo 48 || echo 32)"
  kw --file kdeglobals --group KDE --key SingleClick "$single"
}

js_common='
function clear() { var ps = panels(); for (var i = 0; i < ps.length; i++) ps[i].remove(); }
function setp(p, k, v) { try { p[k] = v; } catch (e) { } }
function tasks(p, plain) {
  var t = p.addWidget(plain ? "org.kde.plasma.taskmanager" : "org.kde.plasma.icontasks");
  t.currentConfigGroup = ["General"];
  t.writeConfig("launchers", ["applications:org.kde.dolphin.desktop", "applications:firefox.desktop", "applications:org.kde.discover.desktop", "applications:s6-companion.desktop"]);
  return t;
}
function tray(p) { p.addWidget("org.kde.plasma.systemtray"); p.addWidget("org.kde.plasma.digitalclock"); }
'

case "${1:-status}" in
layout)
  name=${2:-touch}
  case "$name" in
    touch) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 64; setp(p, "floating", true);
      p.addWidget("org.kde.plasma.kickoff"); tasks(p, false); p.addWidget("org.kde.plasma.marginsseparator"); tray(p); p.addWidget("org.kde.plasma.showdesktop");' ;;
    centered) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 56; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.panelspacer"); p.addWidget("org.kde.plasma.kickoff"); tasks(p, false);
      p.addWidget("org.kde.plasma.panelspacer"); tray(p);' ;;
    traditional) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 48; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.kickoff"); tasks(p, true); tray(p); p.addWidget("org.kde.plasma.showdesktop");' ;;
    topdock) js='clear(); var top = new Panel; top.location = "top"; top.height = 36; setp(top, "floating", false);
      top.addWidget("org.kde.plasma.kickoff"); top.addWidget("org.kde.plasma.appmenu"); top.addWidget("org.kde.plasma.panelspacer"); tray(top);
      var d = new Panel; d.location = "bottom"; d.height = 68; setp(d, "floating", true); setp(d, "lengthMode", "fit");
      setp(d, "alignment", "center"); setp(d, "hiding", "dodgewindows"); tasks(d, false);' ;;
    plasma) js='clear(); loadTemplate("org.kde.plasma.desktop.defaultPanel");' ;;
    *) echo "unknown layout: $name"; exit 2 ;;
  esac
  if [ "${3:-}" = --print ]; then printf '%s\n%s\n' "$js_common" "$js"; exit 0; fi
  plasma_js "$js_common $js" && setconf layout "$name" && echo "layout: $name"
  bash "$SELF" dolphin "$name"
  apply_borders "$name"
  eff=$(getconf effects); [ -n "$eff" ] && bash "$SELF" effects "$eff" >/dev/null   # new panels get the chosen look too
  # The genie-style minimise suits the dock layout; the others shrink windows into the bar.
  if [ "$name" = topdock ]; then kw --file kwinrc --group Plugins --key magiclampEnabled true; kw --file kwinrc --group Plugins --key squashEnabled false
  else kw --file kwinrc --group Plugins --key magiclampEnabled false; kw --file kwinrc --group Plugins --key squashEnabled true; fi
  kwin_reload
  ;;
size)
  name=${2:-larger}
  out=$(kscreen-doctor -j 2>/dev/null | python3 -c 'import json,sys; o=[x for x in json.load(sys.stdin)["outputs"] if x.get("enabled")][0]; print(o["name"], o.get("scale", 1))') \
    || { echo "could not read the screen"; exit 1; }
  set -- $out; output=$1; scale=$2
  base=$(getconf basescale); [ -n "$base" ] || { base=$scale; setconf basescale "$base"; }   # the tablet's original
  case "$name" in standard) add=0 ;; larger) add=0.25 ;; largest) add=0.5 ;; *) echo "unknown size"; exit 2 ;; esac
  new=$(python3 -c "print(round(float('$base') + float('$add'), 2))")
  kscreen-doctor "output.$output.scale.$new" >/dev/null 2>&1 && echo "scale: $new"
  # Plasma's touch mode: bigger hit areas and spacing in KDE apps.
  if [ "$name" = standard ]; then tm=auto; else tm=on; fi
  kwriteconfig6 --file kwinrc --group Input --key TabletMode "$tm"
  "$(q)" org.kde.KWin /KWin reconfigure >/dev/null 2>&1
  setconf size "$name"; echo "size: $name (touch mode $tm)"
  ;;
theme)
  case "${2:-light}" in
    dark) plasma-apply-lookandfeel -a org.kde.breezedark.desktop >/dev/null 2>&1 ;;
    light) plasma-apply-lookandfeel -a org.kde.breeze.desktop >/dev/null 2>&1 ;;
    *) echo "light or dark"; exit 2 ;;
  esac
  setconf theme "$2"; echo "theme: $2"
  ;;
effects)
  lvl=${2:-soft}
  case "$lvl" in off|soft|glassy) ;; *) echo "off, soft or glassy"; exit 2 ;; esac
  # Kept light on the GPU: moderate blur strength, no noise, the blur cache on, no blurred window borders, and
  # forced blur only for a short list of apps (never "everything").
  if [ "$lvl" = off ]; then
    use_blur none; use_style breeze
    kw --file kwinrc --group Plugins --key translucencyEnabled false
    kw --file kwinrc --group Plugins --key contrastEnabled false
    kw --file kdeglobals --group KDE --key AnimationDurationFactor 0.5
    panel_opacity 1
  else
    if has_bbdx; then
      use_blur bbdx
      bbdx --key BlurStrength "$([ "$lvl" = glassy ] && echo 10 || echo 7)"
      bbdx --key NoiseStrength 0
      bbdx --key BlurMenus true
      bbdx --key BlurDocks true
      bbdx --key BlurDecorations false
      bbdx --key BlurNonMatching false
      bbdx --key BlurCacheIgnore false
      bbdx --key CornerRadius 12
      if [ "$lvl" = glassy ]; then
        bbdx --key BlurMatching true
        bbdx --key WindowClasses "$(printf 'dolphin\norg.kde.dolphin\nkonsole\norg.kde.konsole\nsystemsettings\norg.kde.kate\nark')"
      else
        bbdx --key BlurMatching false
      fi
    else
      use_blur stock
      kw --file kwinrc --group Effect-blur --key BlurStrength "$([ "$lvl" = glassy ] && echo 10 || echo 6)"
      kw --file kwinrc --group Effect-blur --key NoiseStrength 0
    fi
    kw --file kwinrc --group Plugins --key contrastEnabled true
    use_style darkly
    # Darkly's see-through parts (100 = solid). Soft: only menus; glassy: sidebar, toolbars and tabs too.
    if [ "$lvl" = glassy ]; then
      for k in MenuOpacity:80 MenuBarOpacity:70 ToolBarOpacity:70 TabBarOpacity:75 DolphinSidebarOpacity:60; do darkly --group Style --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Plugins --key translucencyEnabled true
      for k in Dialogs:94 Inactive:94 MoveResize:88; do kw --file kwinrc --group Effect-translucency --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Effect-translucency --key ActiveWindows 100
      panel_opacity 2
    else
      for k in MenuOpacity:90 MenuBarOpacity:100 ToolBarOpacity:100 TabBarOpacity:100 DolphinSidebarOpacity:100; do darkly --group Style --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Plugins --key translucencyEnabled false
      panel_opacity 0
    fi
    darkly --group Style --key TransparentDolphinView false   # file list stays solid and readable
    darkly --group Common --key CornerRadius 10
    kw --file kdeglobals --group KDE --key AnimationDurationFactor 0.75
    kw --file kwinrc --group Plugins --key scaleEnabled true; kw --file kwinrc --group Plugins --key fadeEnabled false
  fi
  kwin_reload; setconf effects "$2"; echo "effects: $2"
  ;;
dolphin)
  case "${2:-plasma}" in
    touch)       dolphin_style 0 96 true true ;;    # big icons, one tap opens
    centered)    dolphin_style 1 64 false true ;;   # details list, like most taskbar desktops
    traditional) dolphin_style 1 48 false false ;;  # compact details list
    topdock)     dolphin_style 0 80 false true ;;   # icon grid with previews
    plasma)      dolphin_style 0 64 false true ;;   # Dolphin's own default
    *) echo "unknown style"; exit 2 ;;
  esac
  echo "file manager: ${2:-plasma} style (applies the next time Dolphin opens)"
  ;;
install-themes)
  # Each layout as a Plasma Global Theme in your own folder: pick them in System Settings > Colors & Themes > Global Theme
  # too. They set the layout, app style and window borders; light/dark and effects stay as you chose them.
  base="$HOME/.local/share/plasma/look-and-feel"
  n=0
  for id in touch centered traditional topdock plasma; do
    case "$id" in
      touch) title="S6 Touch"; desc="One tall floating bar with big icons, made for fingers" ;;
      centered) title="S6 Centered"; desc="A bottom taskbar with the app icons in the middle" ;;
      traditional) title="S6 Traditional"; desc="Menu on the left and window names in a full-width bar" ;;
      topdock) title="S6 Top Bar and Dock"; desc="A slim top bar with the menu and clock, and a dock below" ;;
      plasma) title="S6 Plasma"; desc="KDE Plasma's own default layout with the S6 look" ;;
    esac
    d="$base/org.s6migrate.$id"; mkdir -p "$d/contents/layouts" "$d/contents/previews"
    cat > "$d/metadata.json" <<JSON
{
    "KPackageStructure": "Plasma/LookAndFeel",
    "KPlugin": {
        "Authors": [ { "Name": "S6 Migrate" } ],
        "Description": "$desc",
        "Id": "org.s6migrate.$id",
        "License": "GPL-2.0-or-later",
        "Name": "$title",
        "Version": "1.0"
    },
    "X-Plasma-APIVersion": "2"
}
JSON
    js=$(bash "$SELF" layout-js "$id")
    printf '%s\n' "$js" > "$d/contents/layouts/org.kde.plasma.desktop-layout.js"
    IFS='|' read -r bl br bs ta cr <<< "$(layout_borders "$id")"
    if has_darkly; then style=Darkly; deco=org.kde.darkly; theme=Darkly; else style=Breeze; deco=org.kde.breeze; theme=Breeze; fi
    printf '[kdeglobals][KDE]\nwidgetStyle=%s\n\n[kwinrc][org.kde.kdecoration2]\nlibrary=%s\ntheme=%s\nButtonsOnLeft=%s\nButtonsOnRight=%s\n' \
      "$style" "$deco" "$theme" "$bl" "$br" > "$d/contents/defaults"
    for pre in /usr/local/share/s6migrate/previews "${S6L_PREVIEWS:-}"; do
      [ -f "$pre/$id.png.b64" ] && { base64 -d "$pre/$id.png.b64" > "$d/contents/previews/preview.png"; cp "$d/contents/previews/preview.png" "$d/contents/previews/fullscreenpreview.jpg"; break; }
    done
    n=$((n+1))
  done
  echo "installed $n S6 layouts as Global Themes"
  ;;
prepare)
  # Before the first login (run by S6 Setup as the new user, no desktop running): everything that is only settings.
  # Plasma builds a new user's first desktop from the Global Theme named in kdeglobals, so the chosen layout's theme
  # makes the very first desktop come up arranged. Screen scale and panel see-through need the running desktop:
  # they are queued and "heal" applies them the moment you log in.
  lay=${2:-touch}; sz=${3:-larger}; th=${4:-light}; eff=${5:-soft}; acc=${6:-}
  case "$acc" in ""|\#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) echo "accent: #RRGGBB"; exit 2 ;; esac
  case "$lay" in touch|centered|traditional|topdock|plasma) ;; *) echo "unknown layout"; exit 2 ;; esac
  case "$sz" in standard|larger|largest) ;; *) echo "unknown size"; exit 2 ;; esac
  case "$th" in light|dark) ;; *) echo "light or dark"; exit 2 ;; esac
  case "$eff" in off|soft|glassy) ;; *) echo "off, soft or glassy"; exit 2 ;; esac
  bash "$SELF" install-themes >/dev/null
  kw --file kdeglobals --group KDE --key LookAndFeelPackage "org.s6migrate.$lay"
  if [ "$th" = dark ]; then kw --file kdeglobals --group General --key ColorScheme BreezeDark; kw --file kdeglobals --group Icons --key Theme breeze-dark
  else kw --file kdeglobals --group General --key ColorScheme BreezeLight; kw --file kdeglobals --group Icons --key Theme breeze; fi
  bash "$SELF" dolphin "$lay" >/dev/null 2>&1
  apply_borders "$lay" >/dev/null 2>&1
  bash "$SELF" effects "$eff" >/dev/null 2>&1   # settings only here; the reload calls simply find no desktop yet
  if [ "$lay" = topdock ]; then kw --file kwinrc --group Plugins --key magiclampEnabled true; kw --file kwinrc --group Plugins --key squashEnabled false
  else kw --file kwinrc --group Plugins --key magiclampEnabled false; kw --file kwinrc --group Plugins --key squashEnabled true; fi
  if [ "$sz" = standard ]; then kw --file kwinrc --group Input --key TabletMode auto; else kw --file kwinrc --group Input --key TabletMode on; fi
  setconf layout "$lay"; setconf theme "$th"; setconf effects "$eff"; setconf size-pending "$sz"; setconf panels-pending 1
  # Your Android accent colour: KDE apps read it from kdeglobals at once; the colour scheme is tinted at the first login.
  if [ -n "$acc" ]; then
    kw --file kdeglobals --group General --key AccentColor "$((16#${acc:1:2})),$((16#${acc:3:2})),$((16#${acc:5:2}))"
    setconf accent-pending "$acc"
  fi
  date > "$(dirname "$CONF")/prepared"
  echo "your desktop is prepared: $lay layout, $sz, $th, $eff effects${acc:+, accent $acc}"
  ;;
layout-js)
  # the panel script for a layout (shared by "layout" and the Global Themes)
  bash "$SELF" layout "${2:-touch}" --print
  ;;
heal)
  # The parts of "prepare" that need the running desktop, once, right at the first login.
  sz=$(getconf size-pending)
  if [ -n "$sz" ]; then sleep 3; bash "$SELF" size "$sz" >/dev/null 2>&1 && setconf size-pending ""; fi
  if [ "$(getconf panels-pending)" = 1 ]; then
    sleep 2
    # Check that the first desktop came up with the prepared layout (Plasma builds it from the Global Theme);
    # if not, apply the layout now.
    lay=$(getconf layout)
    case "$lay" in touch) want="bottom:64" ;; centered) want="bottom:56" ;; traditional) want="bottom:48" ;;
                   topdock) want="bottom:68,top:36" ;; *) want="" ;; esac
    have=$(plasma_js 'print(panels().map(function (p) { return p.location + ":" + p.height }).sort().join(","))' 2>/dev/null)
    [ -n "$want" ] && [ -n "$have" ] && [ "$have" != "$want" ] && bash "$SELF" layout "$lay" >/dev/null 2>&1
    case "$(getconf effects)" in glassy) panel_opacity 2 ;; off) panel_opacity 1 ;; *) panel_opacity 0 ;; esac
    setconf panels-pending 0
  fi
  acc=$(getconf accent-pending)
  if [ -n "$acc" ] && command -v plasma-apply-colorscheme >/dev/null; then
    plasma-apply-colorscheme --accent-color "$acc" >/dev/null 2>&1 && setconf accent-pending ""
  fi
  # Better Blur DX is built for one exact KWin version; after a Fedora update it may not load until it's rebuilt.
  eff=$(getconf effects)
  [ -n "$eff" ] && [ "$eff" != off ] || exit 0
  sleep 8   # let KWin finish loading effects
  if [ "$(kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null)" = true ]; then
    if ! has_bbdx || ! bbdx_loaded; then
      kw --file kwinrc --group Plugins --key blurEnabled true; kwin_reload
      setconf bbdx paused
      command -v notify-send >/dev/null && notify-send -a "S6 Companion" "Using Plasma's blur for now" "Better Blur isn't updated for this Plasma version yet. It switches back by itself."
    elif [ "$(getconf bbdx)" = paused ]; then
      kw --file kwinrc --group Plugins --key blurEnabled false; kwin_reload; setconf bbdx ok
    fi
  fi
  if [ "$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>/dev/null)" = Darkly ] && ! has_darkly; then use_style breeze; fi
  ;;
extras)
  echo "BBDX|$(has_bbdx && echo installed || echo missing)|$(bbdx_loaded && echo loaded || echo not-loaded)"
  echo "DARKLY|$(has_darkly && echo installed || echo missing)"
  ;;
show-panels)
  plasma_js 'panels().forEach(function (p) { p.hiding = "none" })' >/dev/null && echo "Your panels stay visible again."
  ;;
status)
  echo "LAYOUT|$(getconf layout)"; echo "SIZE|$(getconf size)"; echo "THEME|$(getconf theme)"; echo "EFFECTS|$(getconf effects)"
  ;;
*) sed -n '2,16p' "$0"; exit 2 ;;
esac
