js_common='
// Your pinned apps carry over to the new layout (read before the old panels go). The file manager entry follows
// the chosen one (Dolphin or COSMIC Files).
var KEEP = [];
(function () { try { var ps = panels(); for (var i = 0; i < ps.length; i++) { var ws = ps[i].widgets();
  for (var j = 0; j < ws.length; j++) { var w = ws[j];
    if (w.type == "org.kde.plasma.icontasks" || w.type == "org.kde.plasma.taskmanager") {
      w.currentConfigGroup = ["General"]; var l = w.readConfig("launchers");
      if (typeof l === "string") l = l ? l.split(",") : [];
      if (l && l.length) KEEP = l; } } } } catch (e) { } })();
function clear() { var ps = panels(); for (var i = 0; i < ps.length; i++) ps[i].remove(); }
function setp(p, k, v) { try { p[k] = v; } catch (e) { } }
function tasks(p, plain) {
  var t = p.addWidget(plain ? "org.kde.plasma.taskmanager" : "org.kde.plasma.icontasks");
  t.currentConfigGroup = ["General"];
  var fm = "applications:" + (typeof FILES !== "undefined" ? FILES : "org.kde.dolphin.desktop");
  var l = KEEP.length ? KEEP.slice() : [fm, "applications:firefox.desktop", "applications:org.kde.discover.desktop", "applications:s6-companion.desktop"];
  for (var i = 0; i < l.length; i++)
    if (l[i] == "applications:org.kde.dolphin.desktop" || l[i] == "applications:com.system76.CosmicFiles.desktop") l[i] = fm;
  t.writeConfig("launchers", l);
  return t;
}
// The status icons (Wi-Fi, sound, battery, Bluetooth, brightness) live in S6 Quick Settings, an Android-style panel
// that opens when they are tapped; the tray keeps app icons and notifications. Without the widget, the tray as usual.
var QS = "org.s6migrate.quicksettings";
var HIDE = ["org.kde.plasma.networkmanagement", "org.kde.plasma.volume", "org.kde.plasma.battery", "org.kde.plasma.bluetooth",
            "org.kde.plasma.brightness", "org.kde.plasma.keyboardindicator", "org.kde.plasma.manage-inputmethod"];
// The clock like Windows 11: time with the date under it (beside it on a thin top bar)
function clock(p, beside) {
  // the S6 clock: time over date, and your notifications and a calendar when tapped (like Windows 11)
  if (knownWidgetTypes.indexOf("org.s6migrate.clock") >= 0) {
    var s = p.addWidget("org.s6migrate.clock");
    try { s.currentConfigGroup = ["General"]; s.writeConfig("beside", !!beside); } catch (e) { }
    return;
  }
  var c = p.addWidget("org.kde.plasma.digitalclock");
  try { c.currentConfigGroup = ["Appearance"];
        c.writeConfig("showDate", true); c.writeConfig("dateDisplayFormat", beside ? "BesideTime" : "BelowTime");
        c.writeConfig("dateFormat", "shortDate"); c.writeConfig("showSeconds", "Never"); } catch (e) { }
}
function tray(p, beside) {
  var st = p.addWidget("org.kde.plasma.systemtray");
  var qs = null;
  if (knownWidgetTypes.indexOf(QS) >= 0) qs = p.addWidget(QS);
  if (qs) try {
    var c = desktopById(st.readConfig("SystrayContainmentId"));
    c.currentConfigGroup = ["General"];
    c.writeConfig("hiddenItems", HIDE);
  } catch (e) { }
  clock(p, beside);
}
'

case "${1:-status}" in
layout)
  name=${2:-touch}
  case "$name" in
    touch) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 52; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.kickoff"); tasks(p, false); p.addWidget("org.kde.plasma.marginsseparator"); tray(p);' ;;
    centered) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 48; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.panelspacer"); p.addWidget("org.kde.plasma.kickoff"); tasks(p, false);
      p.addWidget("org.kde.plasma.panelspacer"); tray(p);' ;;
    traditional) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 44; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.kickoff"); tasks(p, true); tray(p);' ;;
    topdock) js='clear(); var top = new Panel; top.location = "top"; top.height = 26; setp(top, "floating", false);
      top.addWidget("org.kde.plasma.kickoff"); top.addWidget("org.kde.plasma.appmenu"); top.addWidget("org.kde.plasma.panelspacer"); tray(top, true);
      var d = new Panel; d.location = "bottom"; d.height = 56; setp(d, "floating", true); setp(d, "lengthMode", "fit");
      setp(d, "alignment", "center"); tasks(d, false);' ;;
    plasma) js='clear(); var p = new Panel; p.location = "bottom"; p.height = 44; setp(p, "floating", false);
      p.addWidget("org.kde.plasma.kickoff"); p.addWidget("org.kde.plasma.pager"); tasks(p, false);
      p.addWidget("org.kde.plasma.marginsseparator"); tray(p);' ;;
    *) echo "unknown layout: $name"; exit 2 ;;
  esac
  fj="var FILES = \"$(files_desktop)\";"
  if [ "${3:-}" = --print ]; then printf '%s\n%s\n%s\n' "$fj" "$js_common" "$js"; exit 0; fi
  plasma_js "$fj $js_common $js" && setconf layout "$name" && setconf layout-v "$LAYOUT_V" && echo "layout: $name"
  [ "$(getconf splash)" = none ] || kw --file ksplashrc --group KSplash --key Theme "org.s6migrate.$name"
  # Dolphin is left as Dolphin made it (S6's file manager tweaks were taken out; "s6-look dolphin touch" still has them)
  apply_borders "$name"
  eff=$(getconf effects); [ -n "$eff" ] && bash "$SELF" effects "$eff" >/dev/null   # new panels get the chosen look too
  # The genie-style minimise suits the dock layout; the others shrink windows into the bar.
  if [ "$name" = topdock ]; then kw --file kwinrc --group Plugins --key magiclampEnabled true; kw --file kwinrc --group Plugins --key squashEnabled false
  else kw --file kwinrc --group Plugins --key magiclampEnabled false; kw --file kwinrc --group Plugins --key squashEnabled true; fi
  kwin_reload
  ;;
size)
  name=${2:-larger}
  out=$(kscreen-doctor -j 2>/dev/null | python3 -c 'import json,sys; o=[x for x in json.load(sys.stdin)["outputs"] if x.get("enabled")][0]; print(o["name"], o.get("scale", 1))') \
    || { echo "could not read the screen"; exit 1; }
  set -- $out; output=$1; scale=$2
  base=$(getconf basescale); [ -n "$base" ] || { base=$scale; setconf basescale "$base"; }   # the tablet's original
  case "$name" in standard) add=0 ;; larger) add=0.25 ;; largest) add=0.5 ;; *) echo "unknown size"; exit 2 ;; esac
  new=$(python3 -c "print(round(float('$base') + float('$add'), 2))")
  kscreen-doctor "output.$output.scale.$new" >/dev/null 2>&1 && echo "scale: $new"
  # Plasma's touch mode: bigger hit areas and spacing in KDE apps.
  if [ "$name" = standard ]; then tm=auto; else tm=on; fi
  kwriteconfig6 --file kwinrc --group Input --key TabletMode "$tm"
  kwin_reload
  setconf size "$name"; echo "size: $name (touch mode $tm)"
  ;;
theme)
  # Only the colours (and icons to match): applying Breeze's whole Global Theme here reset the window style and
  # icons too, undoing Darkly and Papirus. Your accent colour (from Android) is kept.
  case "${2:-light}" in
    dark) scheme=BreezeDark ;; light) scheme=BreezeLight ;; *) echo "light or dark"; exit 2 ;;
  esac
  acc=$(getconf accent)
  if [ -n "$acc" ]; then plasma-apply-colorscheme --accent-color "$acc" "$scheme" >/dev/null 2>&1
  else plasma-apply-colorscheme "$scheme" >/dev/null 2>&1; fi || kw --file kdeglobals --group General --key ColorScheme "$scheme"
  plasma-apply-desktoptheme default >/dev/null 2>&1    # Plasma's own theme follows the colours
  setconf theme "$2"; polish "$2"; keyboard "$2"; echo "theme: $2"
  ;;
effects)
  lvl=${2:-soft}
  case "$lvl" in off|soft|glassy) ;; *) echo "off, soft or glassy"; exit 2 ;; esac
  # Kept light on the GPU: moderate blur strength, no noise, the blur cache on, no blurred window borders, and
  # forced blur only for a short list of apps (never "everything").
  if [ "$lvl" = off ]; then
    use_blur none; use_style breeze
    kw --file kwinrc --group Plugins --key translucencyEnabled false
    kw --file kwinrc --group Plugins --key contrastEnabled false
    kw --file kdeglobals --group KDE --key AnimationDurationFactor 0.5
    panel_opacity 1
  else
    if has_bbdx; then
      use_blur bbdx
      bbdx --key BlurStrength "$([ "$lvl" = glassy ] && echo 10 || echo 7)"
      bbdx --key NoiseStrength 0
      bbdx --key BlurMenus true
      bbdx --key BlurDocks true
      bbdx --key BlurDecorations false
      bbdx --key BlurNonMatching false
      bbdx --key BlurCacheIgnore false
      bbdx --key CornerRadius 12
      if [ "$lvl" = glassy ]; then
        bbdx --key BlurMatching true
        bbdx --key WindowClasses "$(printf 'dolphin\norg.kde.dolphin\nkonsole\norg.kde.konsole\nsystemsettings\norg.kde.kate\nark')"
      else
        bbdx --key BlurMatching false
      fi
    else
      use_blur stock
      kw --file kwinrc --group Effect-blur --key BlurStrength "$([ "$lvl" = glassy ] && echo 10 || echo 6)"
      kw --file kwinrc --group Effect-blur --key NoiseStrength 0
    fi
    kw --file kwinrc --group Plugins --key contrastEnabled true
    use_style darkly
    # Darkly's see-through parts (100 = solid). Soft: only menus; glassy: sidebar, toolbars and tabs too.
    if [ "$lvl" = glassy ]; then
      for k in MenuOpacity:80 MenuBarOpacity:70 ToolBarOpacity:70 TabBarOpacity:75 DolphinSidebarOpacity:60; do darkly --group Style --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Plugins --key translucencyEnabled true
      for k in Dialogs:94 Inactive:94 MoveResize:88; do kw --file kwinrc --group Effect-translucency --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Effect-translucency --key ActiveWindows 100
      panel_opacity 2
    else
      for k in MenuOpacity:90 MenuBarOpacity:100 ToolBarOpacity:100 TabBarOpacity:100 DolphinSidebarOpacity:100; do darkly --group Style --key "${k%%:*}" "${k##*:}"; done
      kw --file kwinrc --group Plugins --key translucencyEnabled false
      panel_opacity 2   # translucent panels (the dock too)
    fi
    darkly --group Style --key TransparentDolphinView false   # file list stays solid and readable
    kw --file kdeglobals --group KDE --key AnimationDurationFactor 0.75
    kw --file kwinrc --group Plugins --key scaleEnabled true; kw --file kwinrc --group Plugins --key fadeEnabled false
  fi
  kwin_reload; setconf effects "$2"; echo "effects: $2"
  ;;
kbd-style)  # KEY=VALUE...: S6 Keyboard's theme (auto light dark black tinted), accent (system or #RRGGBB),
            # borders and hints (true/false), height (short normal tall). The keyboard reads it within seconds.
  shift
  for kv in "$@"; do
    k=${kv%%=*}; v=${kv#*=}
    case "$k=$v" in
      theme=auto|theme=light|theme=dark|theme=black|theme=tinted|accent=system|borders=true|borders=false|hints=true|hints=false|height=short|height=normal|height=tall) ;;
      accent=\#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
      *) echo "kbd-style: not understood: $kv"; exit 2 ;;
    esac
    setconf "kb-$k" "$v"
  done
  mkdir -p "$HOME/.config/s6migrate"
  printf '{"theme": "%s", "accent": "%s", "borders": %s, "hints": %s, "height": "%s"}\n' "$(getconf kb-theme)" "$(getconf kb-accent)" \
    "$( [ "$(getconf kb-borders)" = false ] && echo false || echo true)" "$( [ "$(getconf kb-hints)" = false ] && echo false || echo true)" \
    "$(getconf kb-height)" | sed 's/"theme": ""/"theme": "auto"/; s/"accent": ""/"accent": "system"/; s/"height": ""/"height": "normal"/' \
    > "$HOME/.config/s6migrate/keyboard.json"
  echo "keyboard look saved"
  ;;
kbd-over)   # on|off: the on-screen keyboard over the taskbar while it's open (KWin script s6-kbd)
  case "${2:-on}" in
    on)  setconf kbd-over on;  kw --file kwinrc --group Plugins --key s6-kbdEnabled true ;;
    off) setconf kbd-over off; kw --file kwinrc --group Plugins --key s6-kbdEnabled false ;;
    *) echo "usage: s6-look kbd-over on|off"; exit 2 ;;
  esac
  kwin_reload; echo "keyboard over the taskbar: $2"
  ;;
dolphin)
  if [ "${2:-}" = default ]; then dolphin_default; echo "file manager: Dolphin's own settings"; exit 0; fi
  case "${2:-plasma}" in
    touch)       dolphin_style 0 96 true true ;;    # big icons, one tap opens
    centered)    dolphin_style 1 64 false true ;;   # details list, like most taskbar desktops
    traditional) dolphin_style 1 48 false false ;;  # compact details list
    topdock)     dolphin_style 0 80 false true ;;   # icon grid with previews
    plasma)      dolphin_style 0 64 false true ;;   # Dolphin's own default
    *) echo "unknown style"; exit 2 ;;
  esac
  echo "file manager: ${2:-plasma} style (applies the next time Dolphin opens)"
  ;;
install-themes)
  # Each layout as a Plasma Global Theme in your own folder: pick them in System Settings > Colors & Themes > Global Theme
  # too. They set the layout, app style and window borders; light/dark and effects stay as you chose them.
  base="$HOME/.local/share/plasma/look-and-feel"
  n=0
  for id in touch centered traditional topdock plasma; do
    case "$id" in
      touch) title="S6 Touch"; desc="One bar with big icons along the bottom, made for fingers" ;;
      centered) title="S6 Centered"; desc="A bottom taskbar with the app icons in the middle" ;;
      traditional) title="S6 Traditional"; desc="Menu on the left and window names in a full-width bar" ;;
      topdock) title="S6 Top Bar and Dock"; desc="A slim top bar with the menu and clock, and a dock below" ;;
      plasma) title="S6 Plasma"; desc="KDE Plasma's own default layout with the S6 look" ;;
    esac
    d="$base/org.s6migrate.$id"; mkdir -p "$d/contents/layouts" "$d/contents/previews"
    cat > "$d/metadata.json" <<JSON
{
    "KPackageStructure": "Plasma/LookAndFeel",
    "KPlugin": {
        "Authors": [ { "Name": "S6 Migrate" } ],
        "Description": "$desc",
        "Id": "org.s6migrate.$id",
        "License": "GPL-2.0-or-later",
        "Name": "$title",
        "Version": "1.0"
    },
    "X-Plasma-APIVersion": "2"
}
JSON
    js=$(bash "$SELF" layout-js "$id")
    printf '%s\n' "$js" > "$d/contents/layouts/org.kde.plasma.desktop-layout.js"
    IFS='|' read -r bl br bs ta cr <<< "$(layout_borders "$id")"
    if has_darkly; then style=Darkly; deco=org.kde.darkly; theme=Darkly; else style=Breeze; deco=org.kde.breeze; theme=Breeze; fi
    printf '[kdeglobals][KDE]\nwidgetStyle=%s\n\n[kwinrc][org.kde.kdecoration2]\nlibrary=%s\ntheme=%s\nButtonsOnLeft=%s\nButtonsOnRight=%s\n' \
      "$style" "$deco" "$theme" "$bl" "$br" > "$d/contents/defaults"
    for pre in /usr/local/share/s6migrate/previews "${S6L_PREVIEWS:-}"; do
      [ -f "$pre/$id.png.b64" ] && { base64 -d "$pre/$id.png.b64" > "$d/contents/previews/preview.png"; cp "$d/contents/previews/preview.png" "$d/contents/previews/fullscreenpreview.jpg"; break; }
    done
    # The login splash: your wallpaper with a thin progress bar (like a Mac starting your session)
    for o in /usr/local/share/s6migrate/splash "${S6L_SPLASH:-}"; do
      if [ -f "$o/Splash.qml" ]; then
        mkdir -p "$d/contents/splash/images"; cp "$o/Splash.qml" "$d/contents/splash/"
        wp=$(sed -n 's#^Image=\(file://\)\{0,1\}##p' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null | head -n 1)
        [ -d "$wp" ] && wp=$(ls "$wp"/contents/images/* 2>/dev/null | tail -n 1)   # a wallpaper package: its largest picture
        if [ -f "$wp" ]; then cp "$wp" "$d/contents/splash/images/wallpaper"; else rm -f "$d/contents/splash/images/wallpaper"; fi
        break
      fi
    done
    # The on-screen display for volume and brightness: S6's rounded slider
    for o in /usr/local/share/s6migrate/osd "${S6L_OSD:-}"; do
      [ -f "$o/Osd.qml" ] && { mkdir -p "$d/contents/osd"; cp "$o/Osd.qml" "$o/OsdItem.qml" "$d/contents/osd/"; break; }
    done
    n=$((n+1))
  done
  echo "installed $n S6 layouts as Global Themes"
  ;;
prepare)
  # Before the first login (run by S6 Setup as the new user, no desktop running): everything that is only settings.
  # Plasma builds a new user's first desktop from the Global Theme named in kdeglobals, so the chosen layout's theme
  # makes the very first desktop come up arranged. Screen scale and panel see-through need the running desktop:
  # they are queued and "heal" applies them the moment you log in.
  lay=${2:-touch}; sz=${3:-larger}; th=${4:-light}; eff=${5:-soft}; acc=${6:-}
  case "$acc" in ""|\#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) echo "accent: #RRGGBB"; exit 2 ;; esac
  case "$lay" in touch|centered|traditional|topdock|plasma) ;; *) echo "unknown layout"; exit 2 ;; esac
  case "$sz" in standard|larger|largest) ;; *) echo "unknown size"; exit 2 ;; esac
  case "$th" in light|dark) ;; *) echo "light or dark"; exit 2 ;; esac
  case "$eff" in off|soft|glassy) ;; *) echo "off, soft or glassy"; exit 2 ;; esac
  bash "$SELF" install-themes >/dev/null
  kw --file kdeglobals --group KDE --key LookAndFeelPackage "org.s6migrate.$lay"
  if [ "$th" = dark ]; then kw --file kdeglobals --group General --key ColorScheme BreezeDark; kw --file kdeglobals --group Icons --key Theme breeze-dark
  else kw --file kdeglobals --group General --key ColorScheme BreezeLight; kw --file kdeglobals --group Icons --key Theme breeze; fi
  apply_borders "$lay" >/dev/null 2>&1
  bash "$SELF" effects "$eff" >/dev/null 2>&1   # settings only here; the reload calls simply find no desktop yet
  if [ "$lay" = topdock ]; then kw --file kwinrc --group Plugins --key magiclampEnabled true; kw --file kwinrc --group Plugins --key squashEnabled false
  else kw --file kwinrc --group Plugins --key magiclampEnabled false; kw --file kwinrc --group Plugins --key squashEnabled true; fi
  if [ "$sz" = standard ]; then kw --file kwinrc --group Input --key TabletMode auto; else kw --file kwinrc --group Input --key TabletMode on; fi
  setconf layout "$lay"; setconf theme "$th"; setconf effects "$eff"; setconf size-pending "$sz"; setconf panels-pending 1
  # Your Android accent colour: KDE apps read it from kdeglobals at once; the colour scheme is tinted at the first login.
  if [ -n "$acc" ]; then
    kw --file kdeglobals --group General --key AccentColor "$((16#${acc:1:2})),$((16#${acc:3:2})),$((16#${acc:5:2}))"
    setconf accent-pending "$acc"; setconf accent "$acc"
  fi
  polish "$th"; keyboard "$th"
  [ "$(getconf splash)" = none ] || { kw --file ksplashrc --group KSplash --key Engine KSplashQML; kw --file ksplashrc --group KSplash --key Theme "org.s6migrate.$lay"; }
  date > "$(dirname "$CONF")/prepared"
  echo "your desktop is prepared: $lay layout, $sz, $th, $eff effects${acc:+, accent $acc}"
  ;;
layout-js)
  # the panel script for a layout (shared by "layout" and the Global Themes)
  bash "$SELF" layout "${2:-touch}" --print
  ;;
heal)
  # The parts of "prepare" that need the running desktop, once, right at the first login.
  sz=$(getconf size-pending)
  if [ -n "$sz" ]; then sleep 3; bash "$SELF" size "$sz" >/dev/null 2>&1 && setconf size-pending ""; fi
  if [ "$(getconf panels-pending)" = 1 ] || { [ -n "$(getconf layout)" ] && [ "$(getconf layout-v)" != "$LAYOUT_V" ]; }; then
    bash "$SELF" install-themes >/dev/null 2>&1   # the S6 Global Themes (layouts, the rounded volume slider) up to date
    sleep 2
    # Check that the first desktop came up with the prepared layout (Plasma builds it from the Global Theme);
    # if not, apply the layout now.
    lay=$(getconf layout)
    case "$lay" in touch) want="bottom:52" ;; centered) want="bottom:48" ;; traditional) want="bottom:44" ;;
                   topdock) want="bottom:56,top:26" ;; plasma) want="bottom:44" ;; *) want="" ;; esac
    have=$(plasma_js 'print(panels().map(function (p) { return p.location + ":" + p.height }).sort().join(","))' 2>/dev/null)
    if [ -n "$want" ] && [ -n "$have" ] && [ "$have" != "$want" ] || { [ -n "$lay" ] && [ "$(getconf layout-v)" != "$LAYOUT_V" ]; }; then
      bash "$SELF" layout "$lay" >/dev/null 2>&1   # pinned apps are kept
    fi
    case "$(getconf effects)" in off) panel_opacity 1 ;; *) panel_opacity 2 ;; esac   # translucent panels
    setconf panels-pending 0
  fi
  polish; keyboard   # icons, font and keyboard, once the extras arrived (they're installed at a restart)
  tray_tidy
  darkly_glass   # Darkly's Plasma style, see-through like Breeze
  [ "$(getconf dolphin-default)" = 2 ] || dolphin_default   # once: Dolphin back to its own look
  # COSMIC Files arrived since it was chosen: open folders with it and pin it
  if [ "$(getconf files)" = cosmic ] && [ "$(xdg-mime query default inode/directory 2>/dev/null)" != "$(files_desktop)" ]; then
    files_apply; [ "$(files_desktop)" = "$COSMIC_FILES" ] && setconf panels-pending 1
  fi
  acc=$(getconf accent-pending)
  if [ -n "$acc" ] && command -v plasma-apply-colorscheme >/dev/null; then
    plasma-apply-colorscheme --accent-color "$acc" >/dev/null 2>&1 && setconf accent-pending ""
  fi
  # Better Blur DX is built for one exact KWin version; after a Fedora update it may not load until it's rebuilt.
  eff=$(getconf effects)
  [ -n "$eff" ] && [ "$eff" != off ] || exit 0
  sleep 8   # let KWin finish loading effects
  if [ "$(kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null)" = true ]; then
    if ! has_bbdx || ! bbdx_loaded; then
      kw --file kwinrc --group Plugins --key blurEnabled true; kwin_reload
      setconf bbdx paused
      command -v notify-send >/dev/null && notify-send -a "S6 Companion" "Using Plasma's blur for now" "Better Blur isn't updated for this Plasma version yet. It switches back by itself."
    elif [ "$(getconf bbdx)" = paused ]; then
      kw --file kwinrc --group Plugins --key blurEnabled false; kwin_reload; setconf bbdx ok
    fi
  fi
  if [ "$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>/dev/null)" = Darkly ] && ! has_darkly; then use_style breeze; fi
  ;;
extras)
  echo "BBDX|$(has_bbdx && echo installed || echo missing)|$(bbdx_loaded && echo loaded || echo not-loaded)"
  echo "DARKLY|$(has_darkly && echo installed || echo missing)"
  echo "PAPIRUS|$([ -d /usr/share/icons/Papirus ] && echo installed || echo missing)"
  echo "INTER|$(fc-list 2>/dev/null | grep -q -i '/Inter' && echo installed || echo missing)"
  ;;
files)
  case "${2:-}" in dolphin|cosmic) ;; *) echo "dolphin or cosmic"; exit 2 ;; esac
  was=$(files_desktop); setconf files "$2"; files_apply
  if [ "$2" = cosmic ] && [ ! -f "/usr/share/applications/$COSMIC_FILES" ]; then
    echo "COSMIC Files is installed at the next restart, then it opens your folders"
  else
    [ "$(files_desktop)" != "$was" ] && [ -n "$(getconf layout)" ] && bash "$SELF" layout "$(getconf layout)" >/dev/null   # pin it
    echo "file manager: $2"
  fi
  ;;
export)
  # Your desktop's look settings in one file to share (panels, theme, window style, Dolphin, shortcuts, keyboard).
  # Only look-and-feel files: no passwords, browser data or documents.
  out="$HOME/S6-look-settings-$(date +%Y%m%d-%H%M).tar.gz"
  ( cd "$HOME" && tar czf "$out" --ignore-failed-read \
      .config/kdeglobals .config/kwinrc .config/dolphinrc .config/darklyrc .config/breezerc .config/plasmarc \
      .config/plasmashellrc .config/plasma-org.kde.plasma.desktop-appletsrc .config/kglobalshortcutsrc \
      .config/kcminputrc .config/s6migrate/look.conf .local/share/kxmlgui5/dolphin 2>/dev/null )
  dconf dump /org/maliit/ > "$HOME/.cache/s6-maliit.txt" 2>/dev/null && ( cd "$HOME/.cache" && tar rzf "$out" s6-maliit.txt 2>/dev/null )
  echo "saved: $out"
  ;;
splash)
  # The loading screen after logging in: S6's (your wallpaper and a progress bar) or none at all
  case "${2:-}" in
    s6) bash "$SELF" install-themes >/dev/null; lay=$(getconf layout); lay=${lay:-touch}
        kw --file ksplashrc --group KSplash --key Engine KSplashQML; kw --file ksplashrc --group KSplash --key Theme "org.s6migrate.$lay" ;;
    none) kw --file ksplashrc --group KSplash --key Engine none; kw --file ksplashrc --group KSplash --key Theme None ;;
    *) echo "s6 or none"; exit 2 ;;
  esac
  setconf splash "$2"; echo "login splash: $2"
  ;;
show-panels)
  plasma_js 'panels().forEach(function (p) { p.hiding = "none" })' >/dev/null && echo "Your panels stay visible again."
  ;;
status)
  echo "SPLASH|$(getconf splash)"; echo "KBDOVER|$(getconf kbd-over)"; for k in theme accent borders hints height; do echo "KB$(echo $k | tr a-z A-Z)|$(getconf kb-$k)"; done; echo "FILES|$(getconf files)"; echo "LAYOUT|$(getconf layout)"; echo "SIZE|$(getconf size)"; echo "THEME|$(getconf theme)"; echo "EFFECTS|$(getconf effects)"
  ;;
*) sed -n '2,16p' "$0"; exit 2 ;;
esac
