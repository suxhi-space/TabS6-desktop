"""s6-clips: your recent clipboard text for S6 Keyboard's clipboard panel (per user, in your session).

KDE keeps the clipboard history (Klipper, inside Plasma). This asks it for the list every couple of seconds and
writes the newest 30 text clips to $XDG_RUNTIME_DIR/s6-clips.json (only you can read it; it lives in memory and is
gone at log-out). Nothing is sent anywhere.
"""
import json, os, subprocess, time

out = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid(), "s6-clips.json")
last = None
while True:
    try:
        r = subprocess.run(["busctl", "--user", "--json=short", "call", "org.kde.klipper", "/klipper",
                            "org.kde.klipper.klipper", "getClipboardHistoryMenu"], capture_output=True, text=True, timeout=5)
        items = json.loads(r.stdout)["data"][0] if r.returncode == 0 else []
    except Exception:
        items = []
    clips = []
    for t in items:
        t = t if isinstance(t, str) else ""
        if t.strip() and t not in (c["t"] for c in clips):
            clips.append({"t": t[:4000]})
        if len(clips) >= 30:
            break
    if clips != last:
        tmp = out + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(clips, f)
        os.replace(tmp, out)
        last = clips
    time.sleep(2)
