#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# S6 Migrate maintenance before the login screen. Runs only when a job is waiting in /var/lib/s6migrate/maint:
#   repair   finish an update a freeze or forced restart cut off (from s6-selfcheck or S6Migrate-FIX.zip)
#   update   bring Fedora up to date (S6 Setup's first update, or "Update at restart" in S6 Companion)
#   linuxapps  Linux versions of your Android apps (S6 Setup; lines "USER|PACKAGE-PART"), after the update
#   extras   Better Blur DX and Darkly
#   codecs   media codecs from RPM Fusion (their drivers can need matching graphics libraries)
# Desktop packages are never changed under a running desktop: that froze the tablet once and cut a library short.
# Everything is downloaded first (in rounds, keeping what's done, patient with slow Wi-Fi), then installed from
# the downloaded files only, so a Wi-Fi drop can't interrupt installing. Kernel packages are never touched (this
# tablet boots its own kernel); neither are the parts t860-fedora customises. Progress is shown on the screen.
ST=${S6M_STATE:-/var/lib/s6migrate}; M=$ST/maint; L=$ST/maint.log; TTY=${S6M_TTY:-/dev/tty1}   # S6M_*: test hooks
# Any job waiting? (One check per job: listing them all at once failed whenever one was missing, so nothing ran.)
any=0; for j in repair update linuxapps extras codecs; do [ -f "$M/$j" ] && any=1; done
[ $any = 1 ] || exit 0
chvt 1 2>/dev/null
off=$(stat -c %s "$L" 2>/dev/null || echo 0)
exec > >(tee -a "$L" > "$TTY") 2>&1
# "Getting your tablet ready": a progress screen drawn straight on the display (no desktop runs yet) that follows
# this log, with "Show details" for the live output. If it can't start (eglfs, then the plain framebuffer), the
# text above stays on the console as before.
UI=/usr/local/share/s6migrate/app/ready.py
if [ -z "${S6M_NOUI:-}" ] && [ -f "$UI" ] && [ -x /usr/bin/python3 ]; then
  plymouth quit 2>/dev/null
  ( for qpa in eglfs linuxfb; do
      t0=$(date +%s)
      QT_QPA_PLATFORM=$qpa QT_QPA_EGLFS_ALWAYS_SET_MODE=1 /usr/bin/python3 "$UI" "$L" "$off" >>"$ST/ready.log" 2>&1 && break
      [ $(( $(date +%s) - t0 )) -lt 15 ] || break     # it ran a while: not a start-up failure, don't start another
    done ) </dev/null &
fi
ui_stop() { pkill -f "s6migrate/app/ready.py" 2>/dev/null; sleep 1; chvt 1 2>/dev/null; }
say() { echo; echo "== $(date '+%F %T') $*"; }
X='--setopt=excludepkgs=kernel*,sddm,iio-sensor-proxy'
NET='--setopt=minrate=1 --setopt=timeout=120 --setopt=retries=20 --setopt=max_parallel_downloads=3'
jobs=""; for j in repair update linuxapps extras codecs; do [ -f "$M/$j" ] && jobs="$jobs$j "; done
say "S6 Migrate is finishing work before the login screen: $jobs"
say "Keep the tablet plugged in. On slow Wi-Fi this can take a while; it never installs anything half-downloaded."

# A repair waits up to 5 minutes for Wi-Fi; updates and extras only 1, so a tablet that is offline isn't held up
# at every start (they wait for a start with Wi-Fi).
tries=12; [ -f "$M/repair" ] && tries=60
online=0
for i in $(seq 1 $tries); do
  curl -fsI --max-time 8 http://fedoraproject.org >/dev/null 2>&1 && { online=1; break; }
  [ $i = 1 ] && say "Waiting for Wi-Fi..."
  sleep 5
done
if [ $online = 0 ]; then say "No internet: this waits for the next start."; sleep 4; ui_stop; exit 0; fi
d=$(curl -sI --max-time 15 http://fedoraproject.org 2>/dev/null | sed -n 's/^[Dd]ate: //p' | tr -d '\r')
[ -n "$d" ] && date -s "$d" >/dev/null 2>&1 && say "Clock checked: $(date)"

# dnf only shows progress bars on a real terminal; here its output goes through tee into the log, so it is silent
# until something finishes (an 80 MB package list looked frozen). A heartbeat line every minute shows it's alive.
dnfw() {
  local m=0 hb rc
  ( while sleep 60; do m=$((m+1)); echo "   ...still working ($m min)"; done ) &
  hb=$!
  dnf "$@"; rc=$?
  kill "$hb" 2>/dev/null; wait "$hb" 2>/dev/null
  return $rc
}
rounds() { # rounds WHAT [--refresh] COMMAND ARGS...: a download-only dnf command, repeated until it succeeds (30 rounds at most)
  # dnf5 takes --downloadonly only after the command word ("dnf5 distro-sync --downloadonly"), not before it.
  local what=$1 ref="" cmd out; shift
  [ "$1" = --refresh ] && { ref=--refresh; shift; }
  cmd=$1; shift
  for r in $(seq 1 30); do
    say "$what (round $r)..."
    out=$(mktemp)
    if dnfw -y $NET "$X" $ref "$cmd" --downloadonly "$@" 2>&1 | tee "$out"; [ "${PIPESTATUS[0]}" = 0 ]; then rm -f "$out"; return 0; fi
    # A mistake in the command itself won't fix itself by waiting: stop instead of retrying 30 times.
    if grep -q -E 'Unknown argument|No match for argument|Problem: ' "$out"; then rm -f "$out"; say "dnf refused the command (see above); not retrying."; return 1; fi
    rm -f "$out"
    say "Round $r stopped (Wi-Fi?). Keeping what's downloaded; next round in 30 seconds."
    sleep 30
  done
  return 1
}
fail=0
if [ -f "$M/repair" ]; then
  say "Repair 1/4: removing old copies of half-updated packages..."
  dnfw -y remove --duplicates "$X" || true
  say "Repair 2/4: bringing every package to the same, current version..."
  if rounds "Downloading" --refresh distro-sync; then dnfw -y -C "$X" distro-sync || fail=1; else fail=1; fi
  say "Repair 3/4: putting back desktop packages missing from the package list..."
  DESK="kwin kwin-libs kwin-common plasma-workspace plasma-workspace-libs libplasma sddm-wayland-plasma plasma-desktop plasma-workspace-wayland"
  if rounds "Downloading desktop packages" install $DESK; then dnfw -y -C "$X" install $DESK || true; fi
  say "Repair 4/4: checking every installed file (slow), reinstalling packages with damaged files..."
  rpm -Va --nomtime --nouser --nogroup --nomode --nordev --nolinkto --nocaps 2>/dev/null \
    | grep -E '^(..5|.S)' | grep -v ' c /' | awk '{print $NF}' > /tmp/s6-damaged || true
  pk=$(xargs -r rpm -qf --qf '%{NAME}\n' < /tmp/s6-damaged 2>/dev/null | grep -v -E '^(kernel|file |error)' | sort -u | tr '\n' ' ')
  say "Damaged files: $(wc -l < /tmp/s6-damaged); packages to reinstall: ${pk:-none}"
  if [ -n "$pk" ] && rounds "Downloading packages to reinstall" reinstall $pk; then dnfw -y -C "$X" reinstall $pk || fail=1; fi
  if ldd -r /usr/bin/kwin_wayland 2>&1 | grep -q -E 'not found|too short|undefined symbol'; then fail=1; say "The desktop still has a problem."; fi
  [ $fail = 0 ] && rm -f "$M/repair"
fi
if [ -f "$M/update" ] && [ $fail = 0 ]; then
  say "Updating Fedora..."
  if rounds "Downloading updates" --refresh upgrade; then
    if dnfw -y -C "$X" upgrade; then rm -f "$M/update"; date '+%F %T' > "$ST/last-update"; else fail=1; fi
  else fail=1; fi
fi
if [ -f "$M/linuxapps" ] && [ $fail = 0 ]; then
  say "Installing the Linux versions of your apps (Flathub apps download their shared runtimes the first time)..."
  lfail=0
  while IFS='|' read -r u p; do
    [ -n "$u" ] && [ -d "$p" ] || continue
    hd=$(getent passwd "$u" | cut -d: -f6); [ -n "$hd" ] || continue
    dnfw_hb() { local m=0; while sleep 60; do m=$((m+1)); echo "   ...still working ($m min)"; done; }
    dnfw_hb & hb=$!
    runuser -u "$u" -- env HOME="$hd" XDG_DATA_HOME="$hd/.local/share" /usr/local/bin/s6-restore --linux-apps-only --skip-verify --yes "$p" || lfail=1
    kill "$hb" 2>/dev/null; wait "$hb" 2>/dev/null
  done < "$M/linuxapps"
  [ $lfail = 0 ] && rm -f "$M/linuxapps" || say "Some Linux apps didn't install; this is tried again at the next start."
fi
if [ -f "$M/extras" ] && [ $fail = 0 ]; then
  say "Adding Better Blur DX and Darkly..."
  dnf -y copr enable infinality/kwin-effects-better-blur-dx >/dev/null 2>&1
  dnf -y copr enable deltacopy/darkly >/dev/null 2>&1
  got=""
  for p in kwin-effects-better-blur-dx darkly; do
    if rounds "Downloading $p" --refresh install "$p" && dnfw -y -C "$X" install "$p"; then got="$got $p"; fi
  done
  [ -n "$got" ] && say "Added:$got" || say "Not available for this Plasma right now: the standard blur and Breeze are used."
  rm -f "$M/extras"
fi
if [ -f "$M/codecs" ] && [ $fail = 0 ]; then
  say "Adding media codecs (RPM Fusion)..."
  if /usr/local/libexec/s6migrate/s6-helper tune codecs on; then rm -f "$M/codecs"; else fail=1; fi
fi
n=$(cat "$M/attempts" 2>/dev/null || echo 0)
if [ $fail = 1 ]; then
  echo $((n+1)) > "$M/attempts"
  say "Not finished this time (attempt $((n+1))); it continues on the next start. Log: $L"
else
  rm -f "$M/attempts"
  say "All done. Starting the login screen."
fi
sleep 4    # the screen shows "ready" for a moment, then closes itself
ui_stop
exit 0
