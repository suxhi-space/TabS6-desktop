#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# S6 Migrate self-check, every start, before the login screen (a few seconds, no internet).
# Repairs what a forced restart can leave behind, so nobody is locked out of their tablet:
#   - empty login-rule files (every login then fails with "Permission denied"): regenerated with authselect;
#   - a desktop whose files were cut short, or packages left half-installed: maintenance is scheduled (s6-maint),
#     which finishes the update over Wi-Fi before the login screen.
ST=${S6M_STATE:-/var/lib/s6migrate}; M=$ST/maint; L=$ST/selfcheck.log   # S6M_STATE: test hook
mkdir -p "$M"
# Say something on the screen: without it, the start looks frozen at a blinking cursor.
echo "S6 Migrate: checking the system before the login screen..." > /dev/tty1 2>/dev/null
log() { echo "$(date '+%F %T') $*" >> "$L"; }
blank() { ! { grep -v '^ *#' "$1" 2>/dev/null | grep -q '[a-z]'; }; }
real() { readlink -f "$1" 2>/dev/null || echo "$1"; }

# 1. Login rules and user lookups.
broken=""
for f in /etc/pam.d/system-auth /etc/pam.d/password-auth /etc/pam.d/postlogin /etc/nsswitch.conf; do
  blank "$(real "$f")" && broken="$broken $f"
done
if [ -n "$broken" ]; then
  log "empty:$broken"
  blank /etc/authselect/authselect.conf && printf 'local\nwith-silent-lastlog\n' > /etc/authselect/authselect.conf
  authselect apply-changes >> "$L" 2>&1 || authselect select local with-silent-lastlog --force >> "$L" 2>&1
  for f in $broken; do blank "$(real "$f")" && log "STILL EMPTY: $f"; done
fi

# 2. The desktop's own program must be able to load its libraries.
# ldd -r also resolves every symbol: a desktop half-updated to a new version loads, but misses symbols.
if [ -x /usr/bin/kwin_wayland ] && timeout 60 ldd -r /usr/bin/kwin_wayland 2>&1 | grep -q -E 'not found|too short|not a dynamic|invalid ELF|undefined symbol'; then
  log "desktop libraries damaged: $(timeout 60 ldd -r /usr/bin/kwin_wayland 2>&1 | grep -E 'not found|too short|undefined symbol' | head -n 3 | tr '\n' ' ')"
  date > "$M/repair"
fi

# 3. Packages left half-installed (two copies of the same package). Signing keys and kernels are normally there
#    several times (Fedora keeps more than one kernel on purpose).
d=$(timeout 60 rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort | uniq -d | grep -v -E '^(gpg-pubkey|kernel(-.*)?)$' | head -n 5 | tr '\n' ' ')
[ -n "$d" ] && { log "half-installed: $d"; date > "$M/repair"; }
# 3b. A "restart into TWRP" request that Fedora started through instead (bootloader ignored it): clear it, so a later
#     restart doesn't unexpectedly open TWRP.
misc=$(readlink -f /dev/disk/by-partlabel/misc 2>/dev/null)
if [ -b "$misc" ] && [ "$(head -c 13 "$misc" 2>/dev/null)" = boot-recovery ]; then
  dd if=/dev/zero of="$misc" bs=2048 count=1 conv=notrunc 2>/dev/null && log "cleared a restart-into-TWRP request (Fedora started instead)"
fi

# 4. Did the last session end cleanly? If not (a freeze, a forced restart, the battery), keep the end of its log, so the
#    cause can be found: S6 Companion's Fixes page shows these reports. At most the 5 newest are kept.
# Light on purpose (it runs before the login screen): only the last lines of the last session, with time limits.
tail=$(timeout 45 journalctl -b -1 -n 300 --no-pager -q -o short-iso 2>/dev/null)
if [ -n "$tail" ]; then
  if [ -n "$tail" ] && ! printf '%s\n' "$tail" | grep -q -E 'systemd-shutdown|Reached target .*(Power-Off|Reboot|System Shutdown|Halt)|Journal stopped|Shutting down'; then
    R=$ST/freeze-reports; mkdir -p "$R"
    f="$R/$(date '+%Y%m%d-%H%M%S').txt"
    {
      echo "The session before this start did not shut down cleanly (froze, forced restart or power loss)."
      echo "Its last log line: $(printf '%s\n' "$tail" | tail -n 1 | cut -c1-25)"
      echo "----- warnings and errors near the end"
      timeout 30 journalctl -b -1 -p warning -n 60 --no-pager -q -o short-iso 2>/dev/null
      echo "----- last 120 lines"
      printf '%s\n' "$tail" | tail -n 120
    } > "$f" 2>&1
    log "previous session ended without a clean shutdown: $f"
    ls -1t "$R"/*.txt 2>/dev/null | tail -n +6 | xargs -r rm -f
  fi
fi

# Sound: a PipeWire setting that can't open its device stops PipeWire entirely (no sound at all, no screen sharing).
# t860-fedora's microphone node (51-tabs6-mic.conf) fails when the card's capture route isn't up, so let it fail
# alone: "flags = [ nofail ]" on each adapter object in /etc's drop-ins that lacks it.
for f in /etc/pipewire/pipewire.conf.d/*.conf; do
  [ -f "$f" ] && grep -q 'factory *= *adapter' "$f" && ! grep -q 'nofail' "$f" || continue
  cp -n "$f" "$f.s6orig" 2>/dev/null
  sed -i 's/^\([[:space:]]*{[[:space:]]*factory[[:space:]]*=[[:space:]]*adapter\)[[:space:]]*$/\1\n        flags = [ nofail ]/' "$f"
  grep -q nofail "$f" && log "PipeWire: $(basename "$f") may now fail without stopping all sound"
done
exit 0
