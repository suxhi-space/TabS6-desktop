#!/sbin/sh
# SPDX-License-Identifier: GPL-2.0-only
# S6Migrate-FIX.zip: run from TWRP (Install) when Fedora shows a login screen instead of S6 Setup.
# It erases nothing. It:
#   1. shows why logins fail (from Fedora's logs, and from the report its boot check wrote last time);
#   2. gives the two temporary accounts (s6setup, fedora) the password 123456 (S6 Setup removes both);
#   3. makes sure automatic login names the Plasma session, removes stale blockers, keeps logs;
#   4. adds a boot check: 90 s after start it writes a report and, if logins are still blocked,
#      unblocks them and retries automatic login once.
# Everything it shows is also saved as fix-report.txt next to the ZIP (and in S6Migrate on the card).
# Test hooks: S6F_TEST=1 (print to stdout), S6F_ROOT (an unpacked Fedora root instead of userdata), S6F_CARD.
umask 022
# TWRP's shell keeps here-document text in $TMPDIR (Android: /data/local/tmp). /data is Fedora now, so that folder is
# gone and every here-document came out EMPTY (fix 4 "restored" empty files). Use /tmp, and check it works.
export TMPDIR=/tmp
OUTFD=${2:-1}
ROOT=${S6F_ROOT:-/tmp/s6fix-root}
CARD=${S6F_CARD:-/external_sd}
REP=/tmp/s6fix-report.txt
: > "$REP"
ui() { if [ "${S6F_TEST:-0}" = 1 ]; then echo "$*"; else echo "ui_print $*" >> /proc/self/fd/$OUTFD; echo "ui_print" >> /proc/self/fd/$OUTFD; fi; echo "$*" >> "$REP"; }
note() { echo "$*" >> "$REP"; }   # report only (too long for the screen)
ZIPDIR=$(dirname "${3:-/nonexistent/x}")
save() { # next to the ZIP (USB stick or card), and in S6Migrate on the card
  [ -d "$ZIPDIR" ] && cp "$REP" "$ZIPDIR/fix-report.txt" 2>/dev/null
  [ -d "$CARD/S6Migrate" ] && cp "$REP" "$CARD/S6Migrate/fix-report.txt" 2>/dev/null
}
stop() { ui " "; ui "STOPPED: $*"; ui "Nothing was changed."; save; exit 1; }

ui "S6 Migrate fix 8: why won't Fedora start?"
HD=$(cat <<'EOT'
heredoc-ok
EOT
)
if [ "$HD" != heredoc-ok ]; then mkdir -p /tmp/s6fix-tmp; export TMPDIR=/tmp/s6fix-tmp; ui "(text writing switched to /tmp/s6fix-tmp)"; fi
if [ -z "${S6F_ROOT:-}" ]; then
  DEV=$(readlink -f /dev/block/by-name/userdata)
  mkdir -p "$ROOT"
  grep -q " $ROOT " /proc/mounts || mount -t ext4 "$DEV" "$ROOT" || stop "could not open Fedora's storage"
fi
[ -f "$ROOT/etc/os-release" ] && grep -q -i fedora "$ROOT/etc/os-release" || stop "Fedora was not found on this tablet"
S=$ROOT/var/lib/s6migrate

# ---------------------------------------------------------------- what happened last time
ui " "
if [ -f "$S/boot-report.txt" ]; then
  ui "Boot check from the last start:"
  grep -E '^(RESULT|nologin|jobs-waiting|failed-units|s6setup-session|autologin):' "$S/boot-report.txt" | while IFS= read -r l; do ui "  $l"; done
  note "----- full boot report -----"; cat "$S/boot-report.txt" >> "$REP"; note "-----"
else
  ui "No boot check yet (it is added now and runs on the next start)."
fi
if [ -f "$S/repair.log" ]; then
  ui "Last repair:"; grep -E '^== ' "$S/repair.log" | tail -n 4 | cut -c1-100 | while IFS= read -r l; do ui "  $l"; done
  note "----- repair log (last 80 lines) -----"; tail -n 80 "$S/repair.log" >> "$REP"
fi
J=$(ls "$ROOT"/var/log/journal/*/system.journal 2>/dev/null | head -n 1)
if [ -n "$J" ]; then
  ui "Fedora's log, latest login lines:"
  PAT='pam_[a-z_]*\(sddm|nologin|utologin|faillock|sddm-helper|user-sessions|session entry|Authentication|A start job|Dependency failed|undefined symbol|error while loading|core dump|dumped core|kwin_wayland|sddm-greeter|Failed to start|Greeter'
  for jf in $(ls -tr "$ROOT"/var/log/journal/*/*.journal 2>/dev/null | tail -n 3); do
    tr '\000-\037\177-\377' '\n' < "$jf" 2>/dev/null | grep -E "$PAT"
  done | tail -n 40 > /tmp/s6fix-j.txt
  [ -s /tmp/s6fix-j.txt ] || tr -c '[:print:]' '\n' < "$J" 2>/dev/null | grep -E "$PAT" | tail -n 40 > /tmp/s6fix-j.txt
  tail -n 10 /tmp/s6fix-j.txt | cut -c1-110 | while IFS= read -r l; do ui "  ${l#MESSAGE=}"; done
  note "----- journal lines -----"; cat /tmp/s6fix-j.txt >> "$REP"; note "-----"
else
  ui "Fedora keeps no log on disk yet (switched on now)."
fi

# ---------------------------------------------------------------- facts that block logins
ui " "
ui "Checks:"
[ -e "$ROOT/etc/nologin" ] && ui "  /etc/nologin exists: it blocks every login (removed)" && rm -f "$ROOT/etc/nologin"
for u in s6setup fedora; do
  f=$(grep "^$u:" "$ROOT/etc/shadow" | cut -d: -f2 | cut -c1-3)
  ui "  $u: $(grep -q "^$u:" "$ROOT/etc/passwd" && echo account ok || echo NO ACCOUNT), password type '${f:-none}'"
done
ui "  login profile (authselect): $(head -n 1 "$ROOT/etc/authselect/authselect.conf" 2>/dev/null || echo none)"
note "----- /etc/pam.d/sddm -----"; cat "$ROOT/etc/pam.d/sddm" >> "$REP" 2>&1
note "----- /etc/pam.d/sddm-autologin -----"; cat "$ROOT/etc/pam.d/sddm-autologin" >> "$REP" 2>&1
note "----- sddm settings -----"; grep -H -E '^\[|User=|Session=|Relogin=|DisplayServer=|Current=' "$ROOT"/etc/sddm.conf.d/*.conf "$ROOT"/usr/lib/sddm/sddm.conf.d/*.conf >> "$REP" 2>&1
note "----- setup home -----"; ls -la "$S/setup-home" >> "$REP" 2>&1

# ---------------------------------------------------------------- fixes (nothing is erased)
ui " "
ui "Fixes:"
# 1. Temporary password 123456 for the two temporary accounts (numbers: the on-screen keyboard can't capitalise them).
H='$6$s6fixA1$noQeRixSI4F5C9yckNfQpUg/MJifToq6KB4Qor9rpl5u4oq/U0XdsEJhmB0kgawXYPq05AvRQn8BdmXzzVyuV1'
[ -n "$(tail -c 1 "$ROOT/etc/shadow")" ] && echo >> "$ROOT/etc/shadow"
cp "$ROOT/etc/shadow" "$S/shadow.before-fix" && chmod 600 "$S/shadow.before-fix"
while IFS= read -r line; do
  case "$line" in
    s6setup:*|fedora:*) u=${line%%:*}; rest=${line#*:}; rest=${rest#*:}; printf '%s:%s:%s\n' "$u" "$H" "$rest" ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$ROOT/etc/shadow" > /tmp/s6fix-shadow
if [ "$(wc -l < /tmp/s6fix-shadow)" = "$(wc -l < "$ROOT/etc/shadow")" ] && grep -q '^root:' /tmp/s6fix-shadow; then
  cat /tmp/s6fix-shadow > "$ROOT/etc/shadow"; ui "  temporary password 123456 for 'Setting up your tablet' and 'fedora'"
else
  ui "  could not set the temporary password (left as it was)"
fi
rm -f /tmp/s6fix-shadow
# 2. Automatic login into the setup account, with the session named.
C=$ROOT/etc/sddm.conf.d/zz-s6migrate.conf
if [ ! -f "$S/setup-done" ]; then
  mkdir -p "$ROOT/etc/sddm.conf.d"
  printf '# S6 Migrate: the first start logs into the temporary setup account, which runs S6 Setup.\n# S6 Setup replaces this file with your own account when it finishes.\n[General]\nInputMethod=qtvirtualkeyboard\n[Autologin]\nUser=s6setup\nSession=plasma.desktop\n' > "$C"
  chmod 644 "$C"; ui "  automatic login: setup account, Plasma session"
fi
# 3. Stale first-start blockers; logs kept on disk from now on; readable folders.
rm -f "$ROOT/.autorelabel" "$ROOT"/var/run/faillock/* "$ROOT"/var/lib/faillock/* 2>/dev/null
mkdir -p "$ROOT/var/log/journal"
for d in /var/lib/s6migrate /usr/local/libexec/s6migrate /usr/local/share/s6migrate /etc/sddm.conf.d; do
  [ -d "$ROOT$d" ] && find "$ROOT$d" -type d ! -path "*/setup-home*" -exec chmod 755 {} + 2>/dev/null
done
# 4. Login rules (PAM). "Permission denied" for every account means a rule file names a part (module) that isn't
#    installed, or includes a file that doesn't exist. Only what is missing is repaired; originals are kept.
PD=$ROOT/etc/pam.d; LIB=$ROOT/usr/lib64/security; BK=$S/pam.before-fix
mkdir -p "$BK"
write_stack() { gen_stack > "$PD/$1"; chmod 644 "$PD/$1"; }
pam_target() { # where an /etc/pam.d name really lives (follows a symlink inside Fedora)
  t="$PD/$1"; if [ -L "$t" ]; then l=$(readlink "$t"); case "$l" in /*) t="$ROOT$l" ;; *) t="$PD/$l" ;; esac; fi; echo "$t"
}
blank() { ! { grep -v '^ *#' "$1" 2>/dev/null | grep -q '[a-z]'; }; }   # missing, empty, or comments only
gen_stack() { printf '%s\n' \
'# Restored by S6 Migrate fix: this file was empty. Fedora'"'"'s standard local rules (authselect "local" profile).' \
'auth        required                                     pam_env.so' \
'auth        required                                     pam_faildelay.so delay=2000000' \
'auth        sufficient                                   pam_unix.so nullok' \
'auth        required                                     pam_deny.so' \
'' \
'account     required                                     pam_unix.so' \
'' \
'password    requisite                                    pam_pwquality.so' \
'password    sufficient                                   pam_unix.so yescrypt shadow nullok use_authtok' \
'password    required                                     pam_deny.so' \
'' \
'session     optional                                     pam_keyinit.so revoke' \
'session     required                                     pam_limits.so' \
'-session    optional                                     pam_systemd.so' \
'session     [success=1 default=ignore]                   pam_succeed_if.so service in crond quiet use_uid' \
'session     required                                     pam_unix.so'; }
gen_noauth() { printf '%s\n' \
'# Restored by S6 Migrate fix: this file was empty (no fingerprint or smartcard sign-in).' \
'auth        required                                     pam_deny.so' \
'account     required                                     pam_unix.so' \
'password    required                                     pam_deny.so' \
'session     optional                                     pam_keyinit.so revoke' \
'session     required                                     pam_limits.so' \
'-session    optional                                     pam_systemd.so' \
'session     required                                     pam_unix.so'; }
gen_postlogin() { printf '%s\n' '# Restored by S6 Migrate fix: this file was empty.' 'session     optional                   pam_umask.so silent'; }
gen_nss() { printf '%s\n' \
'# Restored by S6 Migrate fix: this file was empty. Fedora'"'"'s standard local lookups.' \
'passwd:     files systemd' 'shadow:     files' 'group:      files systemd' \
'hosts:      files myhostname resolve [!UNAVAIL=return] dns' \
'services:   files' 'netgroup:   files' 'automount:  files' 'aliases:    files' 'ethers:     files' \
'gshadow:    files' 'networks:   files dns' 'protocols:  files' 'publickey:  files' 'rpc:        files'; }
restore() { # restore PATH-IN-/etc GENERATOR: refill an empty core file in place (keeps authselect's symlink)
  local link="$ROOT$1" t
  t=$link; if [ -L "$link" ]; then l=$(readlink "$link"); case "$l" in /*) t="$ROOT$l" ;; *) t="$(dirname "$link")/$l" ;; esac; fi
  blank "$t" || return 0
  [ -f "$t" ] && cp "$t" "$BK/$(basename "$1").empty" 2>/dev/null
  if [ -d "$(dirname "$t")" ]; then $2 > "$t"; else rm -f "$link"; $2 > "$link"; t=$link; fi
  chmod 644 "$t"
  if blank "$t"; then ui "  COULD NOT restore $1 (still empty)"; else ui "  restored $1 (it was empty)"; fixedpam=1; fi
}
fixedpam=0
restore /etc/pam.d/system-auth gen_stack
restore /etc/pam.d/password-auth gen_stack
restore /etc/pam.d/postlogin gen_postlogin
restore /etc/pam.d/fingerprint-auth gen_noauth
restore /etc/pam.d/smartcard-auth gen_noauth
restore /etc/nsswitch.conf gen_nss
if [ -d "$ROOT/etc/authselect" ] && blank "$ROOT/etc/authselect/authselect.conf"; then
  printf 'local\nwith-silent-lastlog\n' > "$ROOT/etc/authselect/authselect.conf"; chmod 644 "$ROOT/etc/authselect/authselect.conf"
  ui "  restored the login profile setting (local)"
fi
# Other files a crash may have emptied: listed in the report, critical ones on screen.
find "$ROOT/etc" -type f -size 0 2>/dev/null | sed "s|^$ROOT||" > /tmp/s6fix-empty
note "----- empty files in /etc -----"; cat /tmp/s6fix-empty >> "$REP"
for c in /etc/passwd /etc/group /etc/shadow /etc/gshadow /etc/hostname /etc/machine-id /etc/fstab /etc/locale.conf /etc/sudoers; do
  grep -qx "$c" /tmp/s6fix-empty && ui "  WARNING: $c is empty"
done
ui "  empty files in /etc: $(wc -l < /tmp/s6fix-empty) (listed in the report)"
checked=""
check_pam() { # check_pam NAME (recursive through include/substack)
  local f bad line m mp t2
  case " $checked " in *" $1 "*) return ;; esac; checked="$checked $1"
  f=$(pam_target "$1")
  if [ ! -f "$f" ] || blank "$f"; then
    note "pam: $1 missing or empty ($( [ -L "$PD/$1" ] && echo "link to $(readlink "$PD/$1")" || echo "no file"))"
    case "$1" in
      system-auth|password-auth) { [ -e "$PD/$1" ] || [ -L "$PD/$1" ]; } && mv "$PD/$1" "$BK/$1.link" 2>/dev/null; write_stack "$1"; ui "  login rules: $1 was missing, restored"; fixedpam=1 ;;
      postlogin) { [ -e "$PD/$1" ] || [ -L "$PD/$1" ]; } && mv "$PD/$1" "$BK/$1.link" 2>/dev/null; printf '#%%PAM-1.0\n# Restored by S6 Migrate fix.\nsession optional pam_umask.so silent\n' > "$PD/$1"; chmod 644 "$PD/$1"; ui "  login rules: postlogin was missing, restored"; fixedpam=1 ;;
      *) ui "  login rules: $1 is missing (not repaired)" ;;
    esac
    f=$(pam_target "$1"); [ -f "$f" ] || return
  fi
  bad=0
  while IFS= read -r line; do
    case "$line" in ''|'#'*|-*) continue ;; esac
    t2=$(echo "$line" | tr -s ' \t' '  ' | cut -d' ' -f2)
    case "$t2" in include|substack) check_pam "$(echo "$line" | tr -s ' \t' '  ' | cut -d' ' -f3)"; continue ;; esac
    m=$(echo "$line" | grep -o '[^ ]*\.so' | head -n 1); [ -n "$m" ] || continue
    case "$m" in /*) mp="$ROOT$m" ;; *) mp="$LIB/$m" ;; esac
    if [ ! -e "$mp" ]; then bad=1; note "pam: $1 uses $m, which is not installed"; fi
  done < "$f"
  if [ $bad = 1 ]; then
    cp "$f" "$BK/$1" 2>/dev/null
    while IFS= read -r line; do
      case "$line" in ''|'#'*|-*) printf '%s\n' "$line"; continue ;; esac
      m=$(echo "$line" | grep -o '[^ ]*\.so' | head -n 1)
      case "$m" in /*) mp="$ROOT$m" ;; *) mp="$LIB/$m" ;; esac
      if [ -n "$m" ] && [ ! -e "$mp" ]; then printf '%s\n' "-$line"; else printf '%s\n' "$line"; fi
    done < "$f" > /tmp/s6fix-pam && cat /tmp/s6fix-pam > "$f"
    ui "  login rules: $1 named parts that aren't installed (now skipped)"; fixedpam=1
  fi
}
for n in sddm sddm-autologin sddm-greeter; do [ -e "$PD/$n" ] || [ -L "$PD/$n" ] && check_pam "$n"; done
[ $fixedpam = 0 ] && ui "  login rules: all files and parts present"
note "pam files: $(ls -l "$PD" 2>&1 | grep -E 'sddm|system-auth|password-auth|postlogin' | tr -s ' ' | cut -d' ' -f1,9- | tr '\n' ';')"
# 5. Packages: an update cut off by a freeze leaves old and new copies, or a desktop of mixed versions; then the
#    login screen can't start. Repair needs the internet, so it is scheduled for the next start, before the login screen.
ui " "
ui "Packages:"
PB=""
if [ -z "${S6F_ROOT:-}" ]; then for d in dev proc sys; do mount -o bind "/$d" "$ROOT/$d" 2>/dev/null && PB="$PB $d"; done; fi
RPMQ=${S6F_RPMQ:-chroot "$ROOT" /usr/bin/rpm}
$RPMQ -qa --qf '%{NAME}\n' 2>/dev/null | sort | { prev=""; while IFS= read -r n; do [ "$n" = "$prev" ] && echo "$n"; prev=$n; done; } | sort -u | grep -v '^gpg-pubkey$' > /tmp/s6fix-dups
$RPMQ -q --qf '%{NAME} %{VERSION}-%{RELEASE}\n' kwin kwin-libs plasma-workspace plasma-workspace-libs libplasma sddm-wayland-plasma kdecoration kwin-effects-better-blur-dx darkly 2>/dev/null > /tmp/s6fix-ver
for d in $PB; do umount "$ROOT/$d" 2>/dev/null || umount -l "$ROOT/$d" 2>/dev/null; done
nd=$(grep -c . /tmp/s6fix-dups)
ui "  half-installed packages (two copies): $nd"
head -n 6 /tmp/s6fix-dups | while IFS= read -r l; do ui "    $l"; done
note "----- duplicate packages -----"; cat /tmp/s6fix-dups >> "$REP"
note "----- desktop versions -----"; cat /tmp/s6fix-ver >> "$REP"
nv=$(grep -v 'not installed' /tmp/s6fix-ver | grep -E '^(kwin|kwin-libs|plasma-workspace|plasma-workspace-libs|libplasma|sddm-wayland-plasma) ' | cut -d' ' -f2 | cut -d- -f1 | sort -u | grep -c .)
ui "  desktop versions: $(grep -E '^(kwin|plasma-workspace-libs|libplasma) ' /tmp/s6fix-ver | tr '\n' ' ' | cut -c1-90)"
note "----- last dnf log -----"; tail -n 40 "$ROOT/var/log/dnf5.log" >> "$REP" 2>/dev/null
nm=$(grep -c -E 'package (kwin|kwin-libs|plasma-workspace|libplasma|sddm-wayland-plasma) is not installed' /tmp/s6fix-ver)
[ "$nm" -gt 0 ] && ui "  desktop packages missing from Fedora's package list: $nm (the cut-off update)"
grep -q 'libkwin.so.6: file too short\|file too short' /tmp/s6fix-j.txt 2>/dev/null && ui "  a desktop file was cut short by the freeze (libkwin.so.6)"
if [ "$nd" -gt 0 ] || [ "$nv" -gt 1 ] || [ "$nm" -gt 0 ] || grep -q 'file too short' /tmp/s6fix-j.txt 2>/dev/null; then
  mkdir -p "$ROOT/usr/local/libexec/s6migrate" "$ROOT/etc/systemd/system/multi-user.target.wants"
  cat > "$ROOT/usr/local/libexec/s6migrate/s6-repair" <<'EOR'
#!/usr/bin/bash
# S6 Migrate: finish an update that a freeze cut off. Runs once at start-up, before the login screen, and shows
# its progress on the screen. Kernel packages are never touched (this tablet boots its own kernel).
L=/var/lib/s6migrate/repair.log
chvt 1 2>/dev/null
exec > >(tee -a "$L" > /dev/tty1) 2>&1
say() { echo; echo "== $(date '+%F %T') $*"; }
say "S6 Migrate is repairing Fedora after an interrupted update. Keep the tablet plugged in. This can take 10-40 minutes."
online=0
for i in $(seq 1 60); do
  curl -fsI --max-time 8 https://mirrors.fedoraproject.org >/dev/null 2>&1 && { online=1; break; }
  [ $i = 1 ] && say "Waiting for Wi-Fi..."
  sleep 5
done
if [ $online = 0 ]; then say "No internet: repair skipped this time (it tries again on the next start)."; exit 0; fi
# Slow or dropping Wi-Fi: patient download settings, and download everything first (in rounds, keeping what's done),
# then install from the downloaded files only, so a Wi-Fi drop can never interrupt the installing step.
X='--setopt=excludepkgs=kernel*'
NET='--setopt=minrate=1 --setopt=timeout=120 --setopt=retries=20 --setopt=max_parallel_downloads=3'
say "Setting the clock from the internet (it was wrong at start-up)..."
d=$(curl -sI --max-time 15 http://fedoraproject.org 2>/dev/null | sed -n 's/^[Dd]ate: //p' | tr -d '\r')
[ -n "$d" ] && date -s "$d" >/dev/null 2>&1 && say "Clock set: $(date)"
rounds() { # rounds DESCRIPTION DNF-ARGS...: repeat a download-only dnf command until it succeeds (up to 30 rounds)
  local what=$1; shift
  for r in $(seq 1 30); do
    say "$what (round $r)..."
    if dnf -y $NET "$X" --downloadonly "$@"; then return 0; fi
    say "Download round $r stopped (weak Wi-Fi?). Keeping what's downloaded; trying again in 30 seconds."
    sleep 30
  done
  return 1
}
say "Step 1 of 4: removing old copies of half-updated packages..."
dnf -y remove --duplicates "$X" || say "(no old copies removed)"
say "Step 2 of 4: bringing every package to the same, current version (kernel left alone)."
say "Downloading first (about 1 GB; on slow Wi-Fi this can take a few hours, leave it plugged in near the router)."
if rounds "Downloading updates" --refresh distro-sync; then
  say "All updates downloaded. Installing them now (no internet needed for this part)..."
  dnf -y -C "$X" distro-sync || say "(installing reported a problem; continuing)"
else
  say "Could not download everything after 30 rounds (it tries again on the next start)."
fi
say "Step 3 of 4: putting back desktop packages missing from the package list..."
DESK="kwin kwin-libs kwin-common plasma-workspace plasma-workspace-libs libplasma sddm-wayland-plasma plasma-desktop plasma-workspace-wayland"
if rounds "Downloading desktop packages" install $DESK; then
  dnf -y -C "$X" install $DESK || say "(some desktop packages could not be installed)"
fi
say "Step 4 of 4: checking every installed file and reinstalling packages with damaged files (this takes a while)..."
rpm -Va --nomtime --nouser --nogroup --nomode --nordev --nolinkto --nocaps 2>/dev/null \
  | grep -E '^(..5|.S)' | grep -v ' c /' | awk '{print $NF}' > /tmp/s6-damaged || true
pk=$(xargs -r rpm -qf --qf '%{NAME}\n' < /tmp/s6-damaged 2>/dev/null | grep -v -E '^(kernel|file |error)' | sort -u | tr '\n' ' ')
say "Damaged files: $(wc -l < /tmp/s6-damaged); packages to reinstall: ${pk:-none}"
if [ -n "$pk" ] && rounds "Downloading packages to reinstall" reinstall $pk; then
  dnf -y -C "$X" reinstall $pk || say "(some packages could not be reinstalled)"
fi
if [ -x /usr/bin/kwin_wayland ] && ldd /usr/bin/kwin_wayland 2>&1 | grep -q -v 'not found\|too short' \
   && ! ldd /usr/bin/kwin_wayland 2>&1 | grep -q 'not found\|too short'; then
  rm -f /var/lib/s6migrate/repair-wanted
  say "Repair finished: the desktop's files check out. Starting the login screen."
else
  say "The desktop still has a problem (it tries again on the next start). Details: /var/lib/s6migrate/repair.log"
fi
chvt 7 2>/dev/null
exit 0
EOR
  chmod 755 "$ROOT/usr/local/libexec/s6migrate/s6-repair"
  printf '%s\n' '[Unit]' 'Description=S6 Migrate: finish an interrupted update' 'Wants=network-online.target' \
    'After=network-online.target NetworkManager.service' 'Before=display-manager.service sddm.service' \
    'ConditionPathExists=/var/lib/s6migrate/repair-wanted' '' '[Service]' 'Type=oneshot' \
    'ExecStart=/usr/local/libexec/s6migrate/s6-repair' 'TimeoutStartSec=infinity' '' '[Install]' 'WantedBy=multi-user.target' \
    > "$ROOT/etc/systemd/system/s6-repair.service"
  ln -sf /etc/systemd/system/s6-repair.service "$ROOT/etc/systemd/system/multi-user.target.wants/s6-repair.service"
  date > "$S/repair-wanted"
  if [ "$(grep -c . "$ROOT/usr/local/libexec/s6migrate/s6-repair")" -gt 20 ]; then
    ui "  REPAIR SCHEDULED: on the next start Fedora finishes the update over Wi-Fi (kernel untouched),"
    ui "  showing its progress on screen, then opens the login screen."
  else
    ui "  COULD NOT write the repair script"
  fi
else
  ui "  packages look consistent"
fi
# 6. Login test: Fedora's own login checks, run inside Fedora from here (as SDDM would), naming the refusing rule.
note "----- login rule files (resolved) -----"
for n in system-auth password-auth postlogin; do note "--- $n"; cat "$(pam_target "$n")" >> "$REP" 2>&1; done
note "--- access.conf"; grep -v '^#' "$ROOT/etc/security/access.conf" 2>/dev/null | grep . >> "$REP"
ui " "
ui "Login test (Fedora's own checks, run from here):"
cat > "$ROOT/tmp/s6pamtest.py" <<'EOPY'
# @PAMTEST@
EOPY
AUTOUSER=$(grep -h '^User=' "$ROOT/etc/sddm.conf.d/zz-s6migrate.conf" 2>/dev/null | tail -n 1 | cut -d= -f2)
[ -n "$AUTOUSER" ] && ui "  automatic login goes to: $AUTOUSER ($(grep -q "^$AUTOUSER:" "$ROOT/etc/passwd" && echo 'account exists' || echo 'NO SUCH ACCOUNT'))"
BOUND=""
if [ -z "${S6F_ROOT:-}" ]; then
  for d in dev proc sys; do mount -o bind "/$d" "$ROOT/$d" 2>/dev/null && BOUND="$BOUND $d"; done
fi
if [ -n "${S6F_PAMRUN:-}" ]; then $S6F_PAMRUN "$ROOT/tmp/s6pamtest.py" $AUTOUSER > /tmp/s6fix-pam.txt 2>&1
else chroot "$ROOT" /usr/bin/python3 -u /tmp/s6pamtest.py $AUTOUSER > /tmp/s6fix-pam.txt 2>&1; echo "exit $?" >> /tmp/s6fix-pam.txt; fi
for d in $BOUND; do umount "$ROOT/$d" 2>/dev/null || umount -l "$ROOT/$d" 2>/dev/null; done
rm -f "$ROOT/tmp/s6pamtest.py" "$ROOT/etc/pam.d/s6fix-probe"
note "----- login test -----"; cat /tmp/s6fix-pam.txt >> "$REP"
if grep -q '^RESULT' /tmp/s6fix-pam.txt; then
  grep '^RESULT' /tmp/s6fix-pam.txt | cut -d' ' -f2- | cut -c1-80 | while IFS= read -r l; do ui "  $l"; done
  grep '^PROBE' /tmp/s6fix-pam.txt | grep -v ' ok Success$' | cut -d' ' -f2- | cut -c1-80 | while IFS= read -r l; do ui "  REFUSED BY: $l"; done
  grep '^LOG' /tmp/s6fix-pam.txt | tail -n 6 | cut -c5-100 | while IFS= read -r l; do ui "  log: $l"; done
else
  ui "  the test could not run:"; tail -n 4 /tmp/s6fix-pam.txt | cut -c1-90 | while IFS= read -r l; do ui "  $l"; done
fi
# 7. Boot check (runs 90 s after the login screen starts; writes the report this ZIP shows next time).
mkdir -p "$ROOT/usr/local/libexec/s6migrate" "$ROOT/etc/systemd/system/sddm.service.wants"
cat > "$ROOT/usr/local/libexec/s6migrate/s6-bootcheck" <<'EOF'
#!/usr/bin/bash
# S6 Migrate boot check: report why logins fail, and unblock them once if they are still blocked.
R=/var/lib/s6migrate/boot-report.txt
sleep 90
s6=$(loginctl list-sessions --no-legend 2>/dev/null | grep -c ' s6setup ')
{
  echo "date: $(date '+%F %T')  uptime: $(cut -d' ' -f1 /proc/uptime)s"
  echo "nologin: $(ls /run/nologin /etc/nologin 2>/dev/null | tr '\n' ' ')"
  echo "jobs-waiting: $(systemctl list-jobs --no-legend 2>/dev/null | wc -l) $(systemctl list-jobs --no-legend 2>/dev/null | awk '{print $2}' | head -n 4 | tr '\n' ' ')"
  echo "failed-units: $(systemctl --failed --no-legend 2>/dev/null | awk '{print $2}' | head -n 6 | tr '\n' ' ')"
  echo "s6setup-session: $s6"
  echo "autologin: $(grep -h -E '^(User|Session)=' /etc/sddm.conf.d/*.conf 2>/dev/null | tr '\n' ' ')"
  echo "----- sessions"; loginctl list-sessions --no-pager 2>&1
  echo "----- jobs"; systemctl list-jobs --no-pager 2>&1 | head -n 30
  echo "----- failed"; systemctl --failed --no-pager 2>&1 | head -n 30
  echo "----- authselect"; authselect current 2>&1 | head -n 6
  echo "----- faillock"; faillock 2>&1 | head -n 20
  echo "----- sddm"; journalctl -b -u sddm --no-pager 2>&1 | tail -n 60
  echo "----- login lines"; journalctl -b --no-pager 2>&1 | grep -i -E 'pam_|nologin|autolog|faillock|sddm-helper|user-sessions' | tail -n 60
} > "$R.new" 2>&1
if [ "$s6" = 0 ] && [ ! -f /var/lib/s6migrate/setup-done ]; then
  echo "RESULT: setup account not logged in after 90 s; unblocking logins and retrying automatic login" >> "$R.new"
  rm -f /run/nologin
  faillock --user s6setup --reset 2>/dev/null; faillock --user fedora --reset 2>/dev/null
  systemctl restart sddm
  sleep 60
  echo "after-retry s6setup-session: $(loginctl list-sessions --no-legend 2>/dev/null | grep -c ' s6setup ')" >> "$R.new"
  journalctl -b -u sddm --no-pager 2>&1 | tail -n 30 >> "$R.new"
else
  echo "RESULT: ok (setup account session: $s6, setup done: $([ -f /var/lib/s6migrate/setup-done ] && echo yes || echo no))" >> "$R.new"
fi
mv "$R.new" "$R"
EOF
chmod 755 "$ROOT/usr/local/libexec/s6migrate/s6-bootcheck"
printf '[Unit]\nDescription=S6 Migrate boot check (first start)\nAfter=sddm.service\nConditionPathExists=!/var/lib/s6migrate/setup-done\n\n[Service]\nType=simple\nExecStart=/usr/local/libexec/s6migrate/s6-bootcheck\n' \
  > "$ROOT/etc/systemd/system/s6-bootcheck.service"
ln -sf /etc/systemd/system/s6-bootcheck.service "$ROOT/etc/systemd/system/sddm.service.wants/s6-bootcheck.service"
ui "  boot check added (report shown the next time you run this ZIP)"

sync
[ -z "${S6F_ROOT:-}" ] && umount "$ROOT"
save
ui " "
ui "Done. Report saved as fix-report.txt next to this ZIP."
ui "Take a photo of this screen, then tap Reboot System."
ui "Wait 3 minutes. If the login screen stays: tap"
ui "'Setting up your tablet' and type 123456."
exit 0
