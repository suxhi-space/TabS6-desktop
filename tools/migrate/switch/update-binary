#!/sbin/sh
# S6 Migrate: switch to Fedora. Runs inside TWRP as a flashable ZIP (META-INF/com/google/android/update-binary).
#
# Steps (each one stops on failure, before anything is erased where possible):
#   1. find the drive holding S6Migrate/fedora (the Fedora download) and the newest package
#   2. verify the Fedora download against its checksums
#   3. run the t860-fedora installer: prepare (no writes), then back up boot/cache/vbmeta to the drive
#   4. write-root: write Fedora to userdata (this is the step that erases Android)
#   5. put the migration in place in the new system (restore tool, first-start assistant, package)
#   6. finish: write boot, cache and vbmeta; verify; reboot into Fedora
#
# Arguments from TWRP: $1 = updater API version, $2 = output fd for messages, $3 = path of this ZIP.
# Test hooks (never set on a real tablet): S6S_TEST=1, S6S_MOUNTS, S6S_ROOTMNT, S6S_INSTALLER, S6S_PAYLOAD.
#
# The drive holds:  S6Migrate/fedora/manifest.env   INSTALLER_BUNDLE="<file>"  ROOTFS_PARTS="<file> <file> ..."
#                   S6Migrate/fedora/SHA256SUMS     checksums of those files (from the release manifest)
#                   S6Migrate/<date>/               the package made by the app
# On failure the script stops and stays in TWRP; it only reboots after everything succeeded.

OUTFD=${2:-1}
ZIP=${3:-}
W=${S6S_WORK:-/tmp/s6migrate-switch}
INST=${S6S_INSTALLER:-/tmp/t860-fedora-installer}
LOG=$W/switch.log

ui() { # show a line on the TWRP screen and in the log
  if [ "${S6S_TEST:-0}" = 1 ]; then echo "$*"; else echo "ui_print $*" >&"$OUTFD"; echo "ui_print" >&"$OUTFD"; fi
  echo "$*" >> "$LOG"
}
progress() { [ "${S6S_TEST:-0}" = 1 ] || echo "set_progress $1" >&"$OUTFD"; }
die() {
  ui " "
  ui "STOPPED: $*"
  [ -n "${STAGE_ERASED:-}" ] && ui "Android was already replaced. Do NOT reboot yet: see S6Migrate/switch-log.txt on your drive and ask for help." \
                              || ui "Nothing was erased. You can reboot to Android normally."
  [ -n "${DRIVE:-}" ] && cp "$LOG" "$DRIVE/S6Migrate/switch-log.txt" 2>/dev/null
  exit 1
}

mkdir -p "$W"; : > "$LOG"
ui "S6 Migrate: switching this Galaxy Tab S6 to Fedora"
ui "Keep the tablet plugged in. Do not press any buttons."

# Unpack this ZIP first: TWRP's cache partition (where the ZIP sits) is replaced later.
if [ -n "$ZIP" ] && [ "${S6S_TEST:-0}" != 1 ]; then
  unzip -o "$ZIP" -d "$W/zip" >/dev/null 2>&1 || die "could not unpack the switch package"
fi

# ---------------------------------------------------------------- 1. find the drive
ui "1/6 Looking for your USB drive or microSD card..."
find_drive() {
  for m in ${S6S_MOUNTS:-$(awk '{print $2}' /proc/mounts)}; do
    if [ -d "$m/S6Migrate/fedora" ]; then
      awk -v m="$m" '$2==m {print $1}' /proc/mounts | head -1 > "$W/drive_dev"
      echo "$m"; return 0
    fi
  done
  # Not mounted yet: try USB drives (sde and up; sda-sdd are internal storage) and the microSD card.
  mkdir -p /tmp/s6m-drive
  for dev in /dev/block/sd[e-z]1 /dev/block/sd[e-z] /dev/block/mmcblk0p1 /dev/block/mmcblk1p1; do
    [ -b "$dev" ] || continue
    for fs in exfat sdfat vfat; do
      if mount -t "$fs" "$dev" /tmp/s6m-drive 2>/dev/null; then
        [ -d /tmp/s6m-drive/S6Migrate/fedora ] && { echo "$dev" > "$W/drive_dev"; echo /tmp/s6m-drive; return 0; }
        umount /tmp/s6m-drive
      fi
    done
  done
  return 1
}
DRIVE=$(find_drive) || die "no drive with an S6Migrate/fedora folder found. Plug in the drive and try again."
F="$DRIVE/S6Migrate/fedora"
ui "   found: $DRIVE"
PKG=$(ls -d "$DRIVE"/S6Migrate/2*/ 2>/dev/null | sort | tail -1); PKG=${PKG%/}
[ -n "$PKG" ] && [ -f "$PKG/plan.txt" ] && ui "   your package: ${PKG##*/}" || ui "   no package found: Fedora will start empty"
progress 0.05

# ---------------------------------------------------------------- 2. verify the download
ui "2/6 Checking the Fedora download (a few minutes)..."
[ -f "$F/manifest.env" ] && [ -f "$F/SHA256SUMS" ] || die "the Fedora download is incomplete (manifest or checksums missing)"
( cd "$F" && sha256sum -c SHA256SUMS >> "$LOG" 2>&1 ) || die "the Fedora download is damaged. Download it again from the app."
. "$F/manifest.env"
ui "   Fedora download OK"
progress 0.15

# ---------------------------------------------------------------- 3. prepare (no writes)
ui "3/6 Preparing (checks only, nothing is written yet)..."
if [ -z "${S6S_INSTALLER:-}" ]; then
  rm -rf "$INST"; mkdir -p "$INST"
  tar -xzf "$F/$INSTALLER_BUNDLE" -C "$INST" || die "could not unpack the installer"
  chmod 755 "$INST/busybox" "$INST/magiskboot" "$INST/patcher" "$INST/bootverify"
  mkdir -p "$INST/bin" && "$INST/busybox" --install -s "$INST/bin"
fi
BB="$INST/busybox"; [ -x "$BB" ] || BB=""
run_inst() { $BB sh "$INST/recovery-install.sh" "$@"; }
run_inst prepare >> "$LOG" 2>&1 || die "the installer's checks did not pass (see switch-log.txt on your drive)"
grep -q PREPARE_PASS "$LOG" || die "the installer's checks did not finish"
BK="$DRIVE/S6Migrate/android-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BK" && cp "$INST"/android-backup/* "$BK"/ || die "could not save the Android boot backup to the drive"
ui "   checks passed; Android boot backup saved to ${BK##*/}"
progress 0.2

# ---------------------------------------------------------------- 4. write Fedora (erases Android)
ui "4/6 Installing Fedora. Android is replaced now (10-20 minutes)..."
STAGE_ERASED=1
# shellcheck disable=SC2086
( for p in $ROOTFS_PARTS; do cat "$F/$p" || exit 1; done ) | run_inst write-root >> "$LOG" 2>&1 \
  || die "writing Fedora failed"
grep -q ROOTFS_WRITE_AND_FIRMWARE_IMPORT_PASS "$LOG" || die "writing Fedora did not finish"
ui "   Fedora written and verified"
progress 0.75

# ---------------------------------------------------------------- 5. migration into the new system
ui "5/6 Setting up your move (restore tool, your package)..."
ROOT=${S6S_ROOTMNT:-/tmp/s6m-root}
if [ -z "${S6S_ROOTMNT:-}" ]; then
  USERDATA=$(readlink -f /dev/block/by-name/userdata 2>/dev/null || readlink -f /dev/block/bootdevice/by-name/userdata)
  mkdir -p "$ROOT" && mount -t ext4 "$USERDATA" "$ROOT" || die "could not open the new system to add your package"
fi
SRC="$W/zip/s6migrate"; [ -d "$SRC" ] || SRC="${S6S_PAYLOAD:-$SRC}"
install -m 755 "$SRC/s6-restore" "$ROOT/usr/local/bin/s6-restore" 2>/dev/null \
  || { mkdir -p "$ROOT/usr/local/bin" && cp "$SRC/s6-restore" "$ROOT/usr/local/bin/s6-restore" && chmod 755 "$ROOT/usr/local/bin/s6-restore"; } \
  || die "could not add the restore tool"
cp "$SRC/s6-firstrun" "$ROOT/usr/local/bin/s6-firstrun" && chmod 755 "$ROOT/usr/local/bin/s6-firstrun" || die "could not add the first-start assistant"
cp "$SRC/s6-doctor" "$ROOT/usr/local/bin/s6-doctor" && chmod 755 "$ROOT/usr/local/bin/s6-doctor" || die "could not add the repair tool"
mkdir -p "$ROOT/etc/xdg/autostart" && cp "$SRC/s6migrate-firstrun.desktop" "$ROOT/etc/xdg/autostart/" || die "could not add the first-start entry"
mkdir -p "$ROOT/var/lib/s6migrate"
if [ -n "$PKG" ]; then
  case "$(cat "$W/drive_dev" 2>/dev/null)" in *mmcblk*|*public:179*) on_card=1 ;; *) on_card=0 ;; esac
  if [ $on_card = 1 ]; then
    # Fedora cannot read the microSD slot yet: copy the package into the new system.
    ui "   copying your package into Fedora (the microSD card is not readable there yet)..."
    cp -a "$PKG" "$ROOT/var/lib/s6migrate/package-${PKG##*/}" || die "copying your package failed (Fedora is installed; copy it later from a computer)"
  else
    echo "$PKG" > "$ROOT/var/lib/s6migrate/package-location"
    ui "   your package stays on the USB drive; plug it in on first start"
  fi
fi
sync
[ -z "${S6S_ROOTMNT:-}" ] && umount "$ROOT"
progress 0.85

# ---------------------------------------------------------------- 6. finish
ui "6/6 Writing the new start-up files and checking them..."
run_inst finish >> "$LOG" 2>&1 || die "the last step failed"
grep -q INSTALLATION_COMPLETE "$LOG" || die "the last step did not finish"
cp "$LOG" "$DRIVE/S6Migrate/switch-log.txt" 2>/dev/null
progress 1
ui " "
ui "Done. Fedora is installed."
ui "The tablet restarts into Fedora. Log in as fedora / fedora and change the password."
ui "S6 Migrate opens by itself and brings your files and apps back."
ui "Restarting in 15 seconds..."
if [ "${S6S_TEST:-0}" != 1 ]; then sleep 15; reboot; fi
exit 0
