#!/sbin/sh
# S6 Migrate: switch to Fedora. Runs inside TWRP as a flashable ZIP (META-INF/com/google/android/update-binary).
#
# Steps (each one stops on failure, before anything is erased where possible):
#   1. find the drive holding S6Migrate/fedora (the Fedora download) and the newest package
#   2. verify the Fedora download against its checksums
#   3. run the t860-fedora installer: prepare (no writes), then back up boot/cache/vbmeta to the drive
#   4. write-root: write Fedora to userdata (this is the step that erases Android)
#   5. put the migration in place in the new system (restore tool, first-start assistant, package)
#   6. finish: write boot, cache and vbmeta; verify; reboot into Fedora
#
# Arguments from TWRP: $1 = updater API version, $2 = output fd for messages, $3 = path of this ZIP.
# Test hooks (never set on a real tablet): S6S_TEST=1, S6S_MOUNTS, S6S_ROOTMNT, S6S_INSTALLER, S6S_PAYLOAD, S6S_DEVDIR.
#
# The drive holds:  S6Migrate/fedora/s6-download.env  INSTALLER_BUNDLE="<file>"  ROOTFS_PARTS="<file> <file> ..."
#                   S6Migrate/fedora/SHA256SUMS     checksums of those files (from the release manifest)
#                   S6Migrate/<date>/               the package made by the app
# On failure the script stops and stays in TWRP; it only reboots after everything succeeded.

OUTFD=${2:-1}
ZIP=${3:-}
W=${S6S_WORK:-/tmp/s6migrate-switch}
INST=${S6S_INSTALLER:-/tmp/t860-fedora-installer}
LOG=$W/switch.log

clear_bcb() { # make the next restart a normal boot (not back into TWRP)
  [ "${S6S_TEST:-0}" = 1 ] && { echo "(test) BCB cleared" >> "$LOG"; return 0; }
  local misc; misc=$(readlink -f /dev/block/by-name/misc 2>/dev/null || readlink -f /dev/block/bootdevice/by-name/misc)
  [ -b "$misc" ] && dd if=/dev/zero of="$misc" bs=32 count=1 conv=notrunc 2>/dev/null
}
ui() { # show a line on the TWRP screen and in the log
  if [ "${S6S_TEST:-0}" = 1 ]; then echo "$*"; else echo "ui_print $*" >> /proc/self/fd/$OUTFD; echo "ui_print" >> /proc/self/fd/$OUTFD; fi
  echo "$*" >> "$LOG"
}
progress() { [ "${S6S_TEST:-0}" = 1 ] || echo "set_progress $1" >> /proc/self/fd/$OUTFD; }
die() {
  ui " "
  ui "STOPPED: $*"
  why=$(grep -E '^ERROR:|^dd:|^cmp:|^head:|Cannot|Read-only|No space' "$LOG" 2>/dev/null | tail -n 2)
  [ -n "$why" ] && printf '%s\n' "$why" | while IFS= read -r l; do ui "   reason: $l"; done
  # Only say Android is gone if the installer really started writing (it logs this line just before).
  if [ -n "${STAGE_ERASED:-}" ] && ! grep -q "userdata is being erased" "$LOG" 2>/dev/null && [ "$STAGE_ERASED" = 1 ]; then
    STAGE_ERASED=""; ui "The installer stopped before writing anything."
  fi
  if [ -n "${STAGE_ERASED:-}" ]; then
    ui "Android was already replaced. Do NOT reboot yet: see S6Migrate/switch-log.txt on your drive and ask for help."
  else
    clear_bcb
    ui "Nothing was erased. Tap Reboot > System to go back to Android."
  fi
  [ -n "${DRIVE:-}" ] && cp "$LOG" "$DRIVE/S6Migrate/switch-log.txt" 2>/dev/null
  exit 1
}

mkdir -p "$W"; : > "$LOG"
# Never run twice: remove the queued TWRP command that started us.
[ "${S6S_TEST:-0}" = 1 ] || rm -f /cache/recovery/openrecoveryscript
ui "S6 Migrate: switching this Galaxy Tab S6 to Fedora"
ui "Keep the tablet plugged in. Do not press any buttons."

# Tools: TWRP builds differ. Use busybox's or toybox's copy of a tool when the plain command is missing.
for t in tar sha256sum gzip unzip; do
  command -v "$t" >/dev/null 2>&1 && continue
  for bb in busybox toybox /sbin/busybox /system/bin/toybox /system/bin/busybox; do
    command -v "$bb" >/dev/null 2>&1 || [ -x "$bb" ] || continue
    if { "$bb" --list 2>/dev/null; "$bb" 2>/dev/null; } | tr ' ' '\n' | grep -qx "$t"; then
      eval "$t() { $bb $t \"\$@\"; }"
      echo "using $bb $t" >> "$LOG"
      break
    fi
  done
done

# The S6 Migrate files (restore tool, first-start assistant, ...). The app embeds them in this script at the
# marker below, so nothing has to be unzipped in TWRP (many TWRP builds have no unzip).
# @S6_EMBED@
if [ "${S6_EMBEDDED:-0}" != 1 ] && [ -n "$ZIP" ] && [ "${S6S_TEST:-0}" != 1 ]; then
  unzip -o "$ZIP" -d "$W/zip" >/dev/null 2>&1 || die "could not unpack the switch package (this TWRP has no unzip; update the S6 Migrate app)"
fi

REHEARSAL=0
{ [ "${S6_MODE:-}" = rehearsal ] || [ -f "$W/zip/s6migrate/REHEARSAL" ] || [ -f "${S6S_PAYLOAD:-/nonexistent}/REHEARSAL" ]; } && REHEARSAL=1
[ $REHEARSAL = 1 ] && ui "REHEARSAL: runs every check, then returns to Android. Nothing is erased."

# ---------------------------------------------------------------- 1. find the drives
ui "1/6 Looking for your USB drive and microSD card..."
# Every drive we can see, mounted by TWRP or mounted here: "<mount point>|<block device>" lines.
list_drives() {
  local m dev n=0
  if [ -n "${S6S_MOUNTS:-}" ]; then
    for m in $S6S_MOUNTS; do        # test hook: "path" or "path=device"
      d=${m#*=}; [ "$d" = "$m" ] && d=""; m=${m%%=*}
      [ -d "$m/S6Migrate" ] && echo "$m|$d"
    done
  else
    while read -r dev m rest; do       # plain shell: some TWRP builds have no awk
      [ -d "$m/S6Migrate" ] && echo "$m|$dev"
    done < /proc/mounts
  fi
  [ -n "${S6S_MOUNTS:-}" ] && return 0
  # Not mounted yet: USB drives (sde and up; sda-sdd are internal storage) and the microSD card.
  for dev in /dev/block/sd[e-z]1 /dev/block/sd[e-z] /dev/block/mmcblk0p1 /dev/block/mmcblk1p1; do
    [ -b "$dev" ] || continue
    grep -q "^$dev " /proc/mounts && continue
    n=$((n+1)); mkdir -p "/tmp/s6m-drive$n"
    for fs in exfat sdfat vfat; do
      if mount -t "$fs" "$dev" "/tmp/s6m-drive$n" 2>/dev/null; then
        if [ -d "/tmp/s6m-drive$n/S6Migrate" ]; then echo "/tmp/s6m-drive$n|$dev"; else umount "/tmp/s6m-drive$n"; fi
        break
      fi
    done
  done
}
list_drives > "$W/drives"
DRIVE=""; PKG=""; PKG_DEV=""; PKGID=""
while IFS='|' read -r m dev; do
  # the drive with the finished Fedora download (s6-download.env is written only once every file is verified)
  [ -z "$DRIVE" ] && [ -f "$m/S6Migrate/fedora/s6-download.env" ] && DRIVE=$m
  for p in "$m"/S6Migrate/2*/; do        # the newest package on any drive
    p=${p%/}; [ -f "$p/plan.txt" ] || continue
    if [ -z "$PKGID" ] || [ "${p##*/}" \> "$PKGID" ]; then PKGID=${p##*/}; PKG=$p; PKG_DEV=$dev; fi
  done
done < "$W/drives"
# A package can be split across drives: every folder with the newest name is one part ("<path>|<device>").
: > "$W/parts"
if [ -n "$PKGID" ]; then
  while IFS='|' read -r m dev; do
    [ -f "$m/S6Migrate/$PKGID/plan.txt" ] && echo "$m/S6Migrate/$PKGID|$dev" >> "$W/parts"
  done < "$W/drives"
fi
NPARTS=$(grep -c . "$W/parts")
WANT=$(sed -n 's/^parts=//p' "$PKG/parts.txt" 2>/dev/null | head -n 1)
[ -n "$DRIVE" ] || die "no drive with a finished Fedora download (S6Migrate/fedora) found. Plug in the drive and try again."
F="$DRIVE/S6Migrate/fedora"
echo "$PKG_DEV" > "$W/drive_dev"
ui "   Fedora download on: $DRIVE"
if [ -n "$PKG" ]; then
  while IFS='|' read -r p dev; do ui "   your package: ${p##*/} on ${p%/S6Migrate/*}"; done < "$W/parts"
  if [ -n "$WANT" ] && [ "$NPARTS" -lt "$WANT" ]; then
    die "your package is split across $WANT drives, but only $NPARTS are plugged in. Plug in the other drive (or card) and try again."
  fi
else
  ui "   no package found: Fedora will start empty"
fi
progress 0.05

# ---------------------------------------------------------------- 2. verify the download
ui "2/6 Checking the Fedora download (a few minutes)..."
[ -f "$F/s6-download.env" ] && [ -f "$F/SHA256SUMS" ] || die "the Fedora download is incomplete (description or checksums missing)"
( cd "$F" && sha256sum -c SHA256SUMS >> "$LOG" 2>&1 ) || die "the Fedora download is damaged. Download it again from the app."
. "$F/s6-download.env"
ui "   Fedora download OK"
progress 0.15

# ---------------------------------------------------------------- 3. prepare (no writes)
ui "3/6 Preparing (checks only, nothing is written yet)..."
if [ -z "${S6S_INSTALLER:-}" ]; then
  rm -rf "$INST"; mkdir -p "$INST"
  { tar -xzf "$F/$INSTALLER_BUNDLE" -C "$INST" 2>>"$LOG" || gzip -dc "$F/$INSTALLER_BUNDLE" | tar -xf - -C "$INST"; } \
    || die "could not unpack the installer"
  chmod 755 "$INST/busybox" "$INST/magiskboot" "$INST/patcher" "$INST/bootverify"
  mkdir -p "$INST/bin" && "$INST/busybox" --install -s "$INST/bin"
fi
BB="$INST/busybox"; [ -x "$BB" ] || BB=""
run_inst() { $BB sh "$INST/recovery-install.sh" "$@"; }
B() { if [ -n "$BB" ]; then "$BB" "$@"; else "$@"; fi; }   # a tool from the installer's busybox
run_inst prepare >> "$LOG" 2>&1 || die "the installer's checks did not pass (see switch-log.txt on your drive)"
grep -q PREPARE_PASS "$LOG" || die "the installer's checks did not finish"
BK="$DRIVE/S6Migrate/android-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BK" && cp "$INST"/android-backup/* "$BK"/ || die "could not save the Android boot backup to the drive"
ui "   checks passed; Android boot backup saved to ${BK##*/}"
progress 0.2

# ---------------------------------------------------------------- before anything is erased (rehearsal too)
# Problems found on a real switch, checked here while nothing has been written yet.
if [ "${S6S_TEST:-0}" != 1 ] || [ -n "${S6S_DEVDIR:-}" ]; then
  ZNAME=${ZIP##*/}; [ -n "$ZNAME" ] || ZNAME="the S6Migrate ZIP"
  # 1. The installer overwrites internal storage and the cache partition, and must be able to unmount them.
  if [ "${S6S_TEST:-0}" != 1 ]; then
    case "$ZIP" in /cache/*|/sdcard/*|/data/*)
      die "this was started from internal storage, which the installer has to overwrite. Install $ZNAME from your card or USB drive instead: Install > Select Storage > microSD card or USB-OTG > S6Migrate" ;;
    esac
    for m in /sdcard /data/media /data /cache; do
      grep -q " $m " /proc/mounts || continue
      umount "$m" 2>/dev/null
      grep -q " $m " /proc/mounts && die "TWRP is still using $m. Tap Mount, tap Disable MTP, then install $ZNAME again"
    done
  fi
  # 2. vbmeta. Samsung write-protects the storage unit it lives on, so TWRP often cannot write it. That's fine when
  #    verification is already off (as on rooted tablets): then it doesn't need writing at all.
  if [ -n "${S6S_DEVDIR:-}" ]; then VBDEV=$S6S_DEVDIR/vbmeta; else VBDEV=$(readlink -f /dev/block/by-name/vbmeta); fi
  want=$(B od -A n -t x1 -j 120 -N 4 "$INST/vbmeta.img" | tr -d ' \n')
  have=$(B od -A n -t x1 -j 120 -N 4 "$VBDEV" | tr -d ' \n')
  VB_WRITE=1
  # Flags are a big-endian number at byte 120; bit 2 = verification disabled.
  case "$have" in "$want"|??????[0-9a-f][2367abef]) VB_WRITE=0 ;; esac
  if [ $VB_WRITE = 1 ]; then
    disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/$(basename "$VBDEV")")")")
    B blockdev --setrw "$VBDEV" 2>/dev/null; [ -b "/dev/block/$disk" ] && B blockdev --setrw "/dev/block/$disk" 2>/dev/null
    if [ "$(B blockdev --getro "$VBDEV" 2>/dev/null)" = 1 ] || [ ! -w "$VBDEV" ]; then
      die "this tablet's vbmeta still has verification on (flags ${have:-unknown}) and TWRP cannot write it. Flash a vbmeta with verification disabled from a computer first (as when rooting), then try again"
    fi
    ui "   vbmeta: will be updated (verification is still on)"
  else
    ui "   vbmeta: verification is already off, nothing to change"
  fi
fi

if [ $REHEARSAL = 1 ]; then
  ui " "
  ui "REHEARSAL PASSED. Nothing was erased."
  ui "Everything the switch needs works in this TWRP. Restarting into Android in 15 seconds..."
  echo "S6MIGRATE-REHEARSAL-PASSED $(date)" >> "$LOG"
  cp "$LOG" "$DRIVE/S6Migrate/switch-log.txt" 2>/dev/null
  clear_bcb
  if [ "${S6S_TEST:-0}" != 1 ]; then sleep 15; reboot; fi
  exit 0
fi

# ---------------------------------------------------------------- 4. write Fedora (erases Android)
ui "4/6 Installing Fedora. Android is replaced now (10-20 minutes)..."
STAGE_ERASED=1
# shellcheck disable=SC2086
( for p in $ROOTFS_PARTS; do cat "$F/$p" || exit 1; done ) | run_inst write-root >> "$LOG" 2>&1 \
  || die "writing Fedora failed"
grep -q ROOTFS_WRITE_AND_FIRMWARE_IMPORT_PASS "$LOG" || die "writing Fedora did not finish"
ui "   Fedora written and verified"
progress 0.75

# ---------------------------------------------------------------- 5. migration into the new system
# Nothing here may stop the switch: Fedora is already written, and step 6 (the boot files) must run
# or the tablet would start neither system. Problems are collected and shown at the end.
ui "5/6 Setting up your move (restore tool, your package)..."
WARN=""
warn() { WARN="$WARN
   - $*"; ui "   warning: $*"; }
ROOT=${S6S_ROOTMNT:-/tmp/s6m-root}
ROOT_OK=1
if [ -z "${S6S_ROOTMNT:-}" ]; then
  USERDATA=$(readlink -f /dev/block/by-name/userdata 2>/dev/null || readlink -f /dev/block/bootdevice/by-name/userdata)
  mkdir -p "$ROOT" && mount -t ext4 "$USERDATA" "$ROOT" || { ROOT_OK=0; warn "could not open the new system to add your package and tools"; }
fi
if [ $ROOT_OK = 1 ]; then
  SRC="$W/zip/s6migrate"; [ -d "$SRC" ] || SRC="${S6S_PAYLOAD:-$SRC}"
  mkdir -p "$ROOT/var/lib/s6migrate"
  # The temporary account that runs S6 Setup on the first start (removed when setup finishes).
  SUID=1990
  for f in passwd group shadow gshadow; do   # never append onto a last line that has no newline
    [ -s "$ROOT/etc/$f" ] && [ -n "$(tail -c 1 "$ROOT/etc/$f")" ] && echo >> "$ROOT/etc/$f"
  done
  if ! grep -q '^s6setup:' "$ROOT/etc/passwd"; then
    while cut -d: -f3 "$ROOT/etc/passwd" | grep -qx "$SUID" || cut -d: -f3 "$ROOT/etc/group" | grep -qx "$SUID"; do SUID=$((SUID+1)); done
    echo "s6setup:x:$SUID:$SUID:Setting up your tablet:/var/lib/s6migrate/setup-home:/bin/bash" >> "$ROOT/etc/passwd"
    echo "s6setup:x:$SUID:" >> "$ROOT/etc/group"
    echo "s6setup:!:20000::::::" >> "$ROOT/etc/shadow"
    [ -f "$ROOT/etc/gshadow" ] && echo "s6setup:!::" >> "$ROOT/etc/gshadow"
  else
    SUID=$(grep '^s6setup:' "$ROOT/etc/passwd" | cut -d: -f3)
  fi
  # S6 Migrate's files: restore tools, S6 Setup, S6 Companion, the root helper and their settings.
  if [ -f "$SRC/install.list" ]; then
    n=0
    while IFS='|' read -r name dest mode owner; do
      case "$name" in ''|'#'*) continue ;; esac
      d=$ROOT$dest
      mkdir -p "${d%/*}"
      if cp "$SRC/$name" "$d"; then
        chmod "${mode:-644}" "$d"
        [ "$owner" = s6setup ] && chown "$SUID:$SUID" "$d"
        n=$((n+1))
      else
        warn "could not add $dest"
      fi
    done < "$SRC/install.list"
    ui "   added $n S6 Migrate files (setup assistant, companion app, tools)"
  else
    warn "this switch package has no file list (update the S6 Migrate app)"
  fi
  # The setup account's desktop: no welcome or update pop-ups over the setup screen.
  H=$ROOT/var/lib/s6migrate/setup-home
  mkdir -p "$H/.config/autostart"
  for a in org.kde.plasma-welcome.desktop org.kde.discover.notifier.desktop imsettings-start.desktop sealertauto.desktop \
           s6migrate-firstrun.desktop org.kde.kalendarac.desktop; do
    printf '[Desktop Entry]\nHidden=true\n' > "$H/.config/autostart/$a"
  done
  printf '[Wallet]\nEnabled=false\nFirst Use=false\n' > "$H/.config/kwalletrc"
  printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > "$H/.config/kscreenlockerrc"
  chown -R "$SUID:$SUID" "$H"; chmod 700 "$H"
  rm -f "$ROOT/etc/xdg/autostart/s6migrate-firstrun.desktop"   # the old text assistant (kept only as a fallback tool)
  # If the image sets automatic login in /etc/sddm.conf itself, that file wins over sddm.conf.d: point it at setup too.
  # (Rewritten in place, so the file keeps its security label.)
  if [ -f "$ROOT/etc/sddm.conf" ] && grep -q '^User=' "$ROOT/etc/sddm.conf"; then
    cp "$ROOT/etc/sddm.conf" "$ROOT/var/lib/s6migrate/sddm.conf.orig"
    sed '/^\[Autologin\]/,/^\[/ s/^User=.*/User=s6setup/' "$ROOT/var/lib/s6migrate/sddm.conf.orig" > "$W/sddm.conf.new" \
      && cat "$W/sddm.conf.new" > "$ROOT/etc/sddm.conf"
  fi
  # SELinux: files written from TWRP have no Fedora security labels. If SELinux is on, let Fedora relabel
  # once on the first start (Fedora's own mechanism; adds a few minutes and one automatic restart).
  # t860-fedora boots with selinux=0: then a relabel only adds a long, silent first start.
  if grep -Eq '^SELINUX=(enforcing|permissive)' "$ROOT/etc/selinux/config" 2>/dev/null \
     && ! { B gunzip -c "$INST/cache.img.gz" 2>/dev/null | grep -q 'selinux=0'; }; then
    : > "$ROOT/.autorelabel"
    ui "   SELinux is on: the first start checks file labels once (a few extra minutes, one restart)"
  fi
  if [ -n "$PKG" ]; then
    k=0; : > "$ROOT/var/lib/s6migrate/package-location"
    { echo "id=$PKGID"; echo "parts=$NPARTS"; } > "$ROOT/var/lib/s6migrate/package.info"
    while IFS='|' read -r p dev; do
      k=$((k+1))
      case "$dev" in *mmcblk*|*public:179*) on_card=1 ;; *) on_card=0 ;; esac
      if [ $on_card = 1 ] && [ -z "${S6S_ROOTMNT:-}" ]; then
        # The new filesystem is only as big as the image (~19 GB) until it is grown; grow it now if the part won't fit.
        need=$(( $(du -sk "$p" | cut -f1) + 1048576 ))
        avail=$(df -Pk "$ROOT" | tail -n 1 | tr -s ' ' | cut -d' ' -f4)
        if [ "${avail:-0}" -lt "$need" ]; then
          if command -v resize2fs >/dev/null 2>&1 && command -v e2fsck >/dev/null 2>&1; then
            ui "   making room: growing Fedora's storage to the full size (a minute)..."
            sync; umount "$ROOT" && { e2fsck -fy "$USERDATA" >> "$LOG" 2>&1; resize2fs "$USERDATA" >> "$LOG" 2>&1; }
            grep -q " $ROOT " /proc/mounts || mount -t ext4 "$USERDATA" "$ROOT" || { ROOT_OK=0; warn "could not reopen the new system after growing it"; break; }
            avail=$(df -Pk "$ROOT" | tail -n 1 | tr -s ' ' | cut -d' ' -f4)
          fi
        fi
        # Never fill Fedora's disk with a half copy: a full disk can stop the desktop from starting.
        if [ "${avail:-0}" -lt "$need" ]; then
          on_card=2
          warn "your package (part $k) doesn't fit into Fedora before its first start; it is still on the card. Copy it to a USB stick (Fedora reads USB) and S6 Setup will find it"
        fi
      fi
      if [ $on_card = 1 ]; then
        # Fedora cannot read the microSD slot yet: copy this part into the new system.
        ui "   copying your package${WANT:+ (part $k)} into Fedora (the microSD card is not readable there yet)..."
        cp -a "$p" "$ROOT/var/lib/s6migrate/package-$PKGID-part$k" \
          && chmod -R a+rX "$ROOT/var/lib/s6migrate/package-$PKGID-part$k" \
          && echo "copied=package-$PKGID-part$k" >> "$ROOT/var/lib/s6migrate/package.info" \
          || { rm -rf "$ROOT/var/lib/s6migrate/package-$PKGID-part$k"
               warn "copying your package failed; it is still on the card. Copy it to a USB stick (Fedora reads USB) and S6 Setup will find it"; }
      elif [ $on_card = 2 ]; then
        :
      else
        echo "$p" >> "$ROOT/var/lib/s6migrate/package-location"
        echo "usb=${p%/S6Migrate/*}" >> "$ROOT/var/lib/s6migrate/package.info"
        ui "   your package${WANT:+ (part $k)} stays on the USB drive; keep it plugged in for the first start"
      fi
    done < "$W/parts"
  fi
  sync
  [ -z "${S6S_ROOTMNT:-}" ] && grep -q " $ROOT " /proc/mounts && umount "$ROOT"
fi
progress 0.85

# ---------------------------------------------------------------- 6. finish
ui "6/6 Writing the new start-up files and checking them..."
STAGE_ERASED=2
if [ "${S6S_TEST:-0}" = 1 ] && [ -z "${S6S_DEVDIR:-}" ]; then
  run_inst finish >> "$LOG" 2>&1 || die "the last step failed"
  grep -q INSTALLATION_COMPLETE "$LOG" || die "the last step did not finish"
else
  # The same steps as the installer's "finish", done here so vbmeta is only written when it needs to be
  # (see the checks before step 4).
  [ -f "$INST/root-written" ] || die "Fedora was not fully written"
  . "$INST/manifest.env"
  if [ -n "${S6S_DEVDIR:-}" ]; then CACHEDEV=$S6S_DEVDIR/cache; VBDEV=$S6S_DEVDIR/vbmeta; BOOTDEV=$S6S_DEVDIR/boot; t=-e
  else CACHEDEV=$(readlink -f /dev/block/by-name/cache); VBDEV=$(readlink -f /dev/block/by-name/vbmeta); BOOTDEV=$(readlink -f /dev/block/by-name/boot); t=-b; fi
  [ $t "$CACHEDEV" ] && [ $t "$VBDEV" ] && [ $t "$BOOTDEV" ] || die "could not find the boot partitions"
  grep -q " /cache " /proc/mounts && umount /cache 2>/dev/null
  B gunzip -c "$INST/cache.img.gz" | B dd of="$CACHEDEV" bs=1048576 >> "$LOG" 2>&1 || die "could not write the new boot area"
  sync
  [ "$(B head -c 419430400 "$CACHEDEV" | B sha256sum | cut -d' ' -f1)" = "$CACHE_RAW_SHA256" ] || die "the new boot area did not verify"
  ui "   boot area written and verified"
  if [ "${VB_WRITE:-1}" = 1 ]; then
    if B dd if="$INST/vbmeta.img" of="$VBDEV" bs=4096 >> "$LOG" 2>&1 && sync \
       && [ "$(B head -c "$(wc -c < "$INST/vbmeta.img")" "$VBDEV" | B sha256sum | cut -d' ' -f1)" = "$(B sha256sum < "$INST/vbmeta.img" | cut -d' ' -f1)" ]; then
      ui "   vbmeta written and verified"
    else
      die "vbmeta could not be written (flags ${have:-unknown}). Flash a vbmeta with verification disabled from a computer, then boot TWRP and install $ZNAME again"
    fi
  fi
  B dd if="$INST/patch/new-boot.img" of="$BOOTDEV" bs=1048576 >> "$LOG" 2>&1 || die "could not write the new boot image"
  sync
  B cmp "$INST/patch/new-boot.img" "$BOOTDEV" >> "$LOG" 2>&1 || die "the new boot image did not verify"
  : > "$INST/installed"; echo INSTALLATION_COMPLETE >> "$LOG"
  ui "   boot image written and verified"
fi
cp "$LOG" "$DRIVE/S6Migrate/switch-log.txt" 2>/dev/null
progress 1
ui " "
ui "Done. Fedora is installed."
